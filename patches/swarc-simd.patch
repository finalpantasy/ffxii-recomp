+#include <initializer_list>
+
+#include "x86/mmx.h"
+
+namespace {
+
+int failures = 0;
+
+void Check(const recomp::Mmx& got, const recomp::Mmx& want, const char* name) {
+  if (std::memcmp(got.b, want.b, 8) == 0) return;
+  std::fprintf(stderr, "%s mismatch\n", name);
+  failures++;
+}
+
+template <typename T>
+recomp::Mmx Make(std::initializer_list<T> values) {
+  recomp::Mmx x{};
+  int i = 0;
+  for (T v : values) recomp::mmx::SetLane<T>(x, i++, v);
+  return x;
+}
+
+}  // namespace
+
+int main() {
+  using namespace recomp;
+  auto a = Make<uint16_t>({1, 2, 32767, 65535});
+  auto b = Make<uint16_t>({5, 6, 2, 2});
+  auto r = a;
+  mmx::Add<uint16_t>(r, b);
+  Check(r, Make<uint16_t>({6, 8, 32769, 1}), "paddw");
+  r = a;
+  mmx::Sub<uint16_t>(r, b);
+  Check(r, Make<uint16_t>({65532, 65532, 32765, 65533}), "psubw");
+  r = Make<int16_t>({32767, -32768, 100, -100});
+  mmx::AddSat<int16_t>(r, Make<int16_t>({1, 0, 200, 0}), false);
+  Check(r, Make<int16_t>({32767, -32768, 300, -100}), "paddsw positive saturation");
+  r = Make<int16_t>({-32768, 32767, 100, -100});
+  mmx::AddSat<int16_t>(r, Make<int16_t>({1, 1, 0, 0}), true);
+  Check(r, Make<int16_t>({-32768, 32766, 100, -100}), "paddsw negative saturation");
+  r = Make<uint16_t>({1, 2, 3, 4});
+  mmx::CmpEq<uint16_t>(r, Make<uint16_t>({1, 0, 3, 0}));
+  Check(r, Make<uint16_t>({65535, 0, 65535, 0}), "pcmpeqw");
+  r = Make<int16_t>({1000, -1000, 2000, -2000});
+  mmx::MulLo<int16_t>(r, Make<int16_t>({20, 20, 20, 20}));
+  Check(r, Make<int16_t>({20000, -20000, -25536, 25536}), "pmullw");
+  r = Make<int16_t>({-2, 1000, 32767, -32768});
+  mmx::MulHi16<int16_t>(r, Make<int16_t>({3, 3, 3, 3}));
+  Check(r, Make<uint16_t>({65535, 0, 1, 65534}), "pmulhw");
+  r = Make<uint16_t>({65535, 65535, 65535, 65535});
+  mmx::MulHi16<uint16_t>(r, Make<uint16_t>({65535, 65535, 65535, 65535}));
+  Check(r, Make<uint16_t>({65534, 65534, 65534, 65534}), "pmulhuw");
+  r = Make<int16_t>({1, 2, 3, 4});
+  mmx::MAddWd(r, Make<int16_t>({5, 6, 7, 8}));
+  Check(r, Make<uint32_t>({17, 53}), "pmaddwd");
+  r = Make<uint8_t>({255, 255, 1, 2, 3, 4, 5, 6});
+  mmx::MAddUbsw(r, Make<int8_t>({127, 127, -1, 2, 3, 4, 5, 6}));
+  Check(r, Make<int16_t>({32767, 3, 25, 61}), "pmaddubsw");
+  r = Make<int16_t>({1, -2, 32767, -32768});
+  mmx::Shift<int16_t>(r, 2, mmx::kShl);
+  Check(r, Make<uint16_t>({4, 65528, 65532, 0}), "psllw");
+  r = Make<int16_t>({-2, 16, -32768, 32});
+  mmx::Shift<int16_t>(r, 2, mmx::kSar);
+  Check(r, Make<int16_t>({-1, 4, -8192, 8}), "psraw");
+  r = Make<uint16_t>({65535, 16, 32768, 32});
+  mmx::Shift<uint16_t>(r, 2, mmx::kShr);
+  Check(r, Make<uint16_t>({16383, 4, 8192, 8}), "psrlw");
+  r = Make<uint64_t>({0xF000000000000000ull});
+  mmx::Shift<uint64_t>(r, 70, mmx::kShr);
+  Check(r, Make<uint64_t>({0}), "psrlq large count");
+  r = Make<uint8_t>({0, 1, 2, 3, 4, 5, 6, 7});
+  mmx::Unpck<uint8_t>(r, Make<uint8_t>({8, 9, 10, 11, 12, 13, 14, 15}), false);
+  Check(r, Make<uint8_t>({0, 8, 1, 9, 2, 10, 3, 11}), "punpcklbw");
+  r = Make<uint8_t>({0, 1, 2, 3, 4, 5, 6, 7});
+  mmx::Unpck<uint8_t>(r, Make<uint8_t>({8, 9, 10, 11, 12, 13, 14, 15}), true);
+  Check(r, Make<uint8_t>({4, 12, 5, 13, 6, 14, 7, 15}), "punpckhbw");
+  r = Make<int16_t>({-1, 128, 300, 0});
+  mmx::Pack<int16_t, uint8_t>(r, Make<int16_t>({1, 255, 256, -100}));
+  Check(r, Make<uint8_t>({0, 128, 255, 0, 1, 255, 255, 0}), "packuswb");
+  r = Make<uint8_t>({0, 1, 2, 3, 4, 5, 6, 7});
+  mmx::SadBw(r, Make<uint8_t>({7, 0, 0, 0, 0, 0, 0, 0}));
+  Check(r, Make<uint64_t>({35}), "psadbw");
+  r = Make<uint64_t>({0x00FF00FF00FF00FFull});
+  mmx::Xor(r, Make<uint64_t>({0x0F0F0F0F0F0F0F0Full}));
+  Check(r, Make<uint64_t>({0x0FF00FF00FF00FF0ull}), "pxor");
+
+  Ctx c{};
+  mmx::Mark(c, 3, r);
+  if (c.fpu.empty != 0 || c.fpu.r[3].se != 0xFFFF ||
+      std::memcmp(&c.fpu.r[3].sig, r.b, 8) != 0) {
+    std::fprintf(stderr, "MMX-to-x87 state mismatch\n");
+    failures++;
+  }
+  mmx::Emms(c);
+  if (c.fpu.empty != 0xFF) {
+    std::fprintf(stderr, "EMMS did not empty the x87 registers\n");
+    failures++;
+  }
+  if (failures == 0) std::puts("MMX tests passed");
+  return failures ? 1 : 0;
+}
