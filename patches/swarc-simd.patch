diff --git a/src/x86/mmx.h b/src/x86/mmx.h
new file mode 100644
index 0000000..f3024d4
--- /dev/null
+++ b/src/x86/mmx.h
@@ -0,0 +1,166 @@
+#pragma once
+
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <type_traits>
+
+#include "x86/ctx.h"
+
+namespace recomp {
+
+namespace mmx {
+
+template <typename T>
+inline T Lane(const Mmx& x, int i) {
+  T v;
+  std::memcpy(&v, x.b + i * sizeof(T), sizeof(T));
+  return v;
+}
+
+template <typename T>
+inline void SetLane(Mmx& x, int i, T v) {
+  std::memcpy(x.b + i * sizeof(T), &v, sizeof(T));
+}
+
+inline Mmx Ld(const uint8_t* B, uint64_t a) {
+  Mmx x;
+  std::memcpy(x.b, B + a, 8);
+  return x;
+}
+
+inline void St(uint8_t* B, uint64_t a, const Mmx& x) {
+  std::memcpy(B + a, x.b, 8);
+}
+
+inline void Mark(Ctx& c, int i, const Mmx& x) {
+  c.fpu.empty = 0;
+  c.fpu.r[i].se = 0xFFFF;
+  std::memcpy(&c.fpu.r[i].sig, x.b, 8);
+}
+
+inline void Emms(Ctx& c) {
+  c.fpu.empty = 0xFF;
+}
+
+template <typename T>
+inline void Add(Mmx& d, const Mmx& s) {
+  for (int i = 0; i < int(8 / sizeof(T)); i++)
+    SetLane<T>(d, i, T(Lane<T>(d, i) + Lane<T>(s, i)));
+}
+
+template <typename T>
+inline void Sub(Mmx& d, const Mmx& s) {
+  for (int i = 0; i < int(8 / sizeof(T)); i++)
+    SetLane<T>(d, i, T(Lane<T>(d, i) - Lane<T>(s, i)));
+}
+
+template <typename T>
+inline void AddSat(Mmx& d, const Mmx& s, bool sub) {
+  for (int i = 0; i < int(8 / sizeof(T)); i++) {
+    int32_t v = sub ? int32_t(Lane<T>(d, i)) - int32_t(Lane<T>(s, i))
+                    : int32_t(Lane<T>(d, i)) + int32_t(Lane<T>(s, i));
+    constexpr int32_t lo = std::numeric_limits<T>::min(), hi = std::numeric_limits<T>::max();
+    SetLane<T>(d, i, T(v < lo ? lo : v > hi ? hi : v));
+  }
+}
+
+template <typename T>
+inline void CmpEq(Mmx& d, const Mmx& s) {
+  for (int i = 0; i < int(8 / sizeof(T)); i++)
+    SetLane<T>(d, i, Lane<T>(d, i) == Lane<T>(s, i) ? T(~T(0)) : T(0));
+}
+
+template <typename T>
+inline void MulLo(Mmx& d, const Mmx& s) {
+  for (int i = 0; i < int(8 / sizeof(T)); i++)
+    SetLane<T>(d, i, T(uint64_t(Lane<T>(d, i)) * Lane<T>(s, i)));
+}
+
+template <typename T>
+inline void MulHi16(Mmx& d, const Mmx& s) {
+  using P = std::conditional_t<std::is_signed_v<T>, int32_t, uint32_t>;
+  for (int i = 0; i < 4; i++)
+    SetLane<uint16_t>(d, i, uint16_t((P(Lane<T>(d, i)) * P(Lane<T>(s, i))) >> 16));
+}
+
+inline void MAddWd(Mmx& d, const Mmx& s) {
+  Mmx r;
+  for (int i = 0; i < 2; i++) {
+    uint32_t a = uint32_t(int32_t(Lane<int16_t>(d, 2 * i)) * Lane<int16_t>(s, 2 * i));
+    uint32_t b = uint32_t(int32_t(Lane<int16_t>(d, 2 * i + 1)) * Lane<int16_t>(s, 2 * i + 1));
+    SetLane<uint32_t>(r, i, a + b);
+  }
+  d = r;
+}
+
+inline void MAddUbsw(Mmx& d, const Mmx& s) {
+  Mmx r;
+  for (int i = 0; i < 4; i++) {
+    int32_t v = int32_t(d.b[2 * i]) * int8_t(s.b[2 * i]) +
+                int32_t(d.b[2 * i + 1]) * int8_t(s.b[2 * i + 1]);
+    SetLane<int16_t>(r, i, int16_t(v < -32768 ? -32768 : v > 32767 ? 32767 : v));
+  }
+  d = r;
+}
+
+enum ShiftKind : uint8_t { kShl, kShr, kSar };
+
+template <typename T>
+inline void Shift(Mmx& d, uint64_t count, ShiftKind k) {
+  using S = std::make_signed_t<T>;
+  constexpr uint64_t kBits = sizeof(T) * 8;
+  for (int i = 0; i < int(8 / sizeof(T)); i++) {
+    T v = Lane<T>(d, i);
+    if (k == kSar)
+      v = T(S(v) >> (count >= kBits ? kBits - 1 : count));
+    else if (count >= kBits)
+      v = 0;
+    else
+      v = k == kShl ? T(v << count) : T(v >> count);
+    SetLane<T>(d, i, v);
+  }
+}
+
+template <typename T>
+inline void Unpck(Mmx& d, const Mmx& s, bool high) {
+  constexpr int n = int(8 / sizeof(T));
+  Mmx r;
+  int b = high ? n / 2 : 0;
+  for (int i = 0; i < n / 2; i++) {
+    SetLane<T>(r, 2 * i, Lane<T>(d, b + i));
+    SetLane<T>(r, 2 * i + 1, Lane<T>(s, b + i));
+  }
+  d = r;
+}
+
+template <typename From, typename To>
+inline void Pack(Mmx& d, const Mmx& s) {
+  constexpr int n = int(8 / sizeof(From));
+  auto sat = [](From v) {
+    constexpr From lo = From(std::numeric_limits<To>::min()),
+                   hi = From(std::numeric_limits<To>::max());
+    return To(v < lo ? lo : v > hi ? hi : v);
+  };
+  Mmx r;
+  for (int i = 0; i < n; i++) SetLane<To>(r, i, sat(Lane<From>(d, i)));
+  for (int i = 0; i < n; i++) SetLane<To>(r, n + i, sat(Lane<From>(s, i)));
+  d = r;
+}
+
+inline void SadBw(Mmx& d, const Mmx& s) {
+  uint32_t sum = 0;
+  for (int i = 0; i < 8; i++) {
+    int a = d.b[i], b = s.b[i];
+    sum += uint32_t(a > b ? a - b : b - a);
+  }
+  d = {};
+  SetLane<uint16_t>(d, 0, uint16_t(sum));
+}
+
+inline void Xor(Mmx& d, const Mmx& s) {
+  for (int i = 0; i < 8; i++) d.b[i] ^= s.b[i];
+}
+
+}  // namespace mmx
+}  // namespace recomp
