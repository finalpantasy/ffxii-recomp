+#include <atomic>
 #include <cstdint>
 #include <map>
+#include <memory>
 #include <mutex>
 #include <vector>
 
@@ -70,7 +72,13 @@ class GuestHeap {
   ~GuestHeap();
 
   uint64_t handle() const { return handle_; }
+  // Test only: number of 64 KiB small-block chunks reserved so far.
+  size_t SmallChunkCountForTest() const;
 
+  // Blocks of up to kSmallMax bytes of a growable heap come from a
+  // size-class fast path (no tree, one of kShards short locks); larger
+  // ones, and every block of a heap with a maximum size, use the general
+  // best-fit allocator under mu_.
   uint64_t Alloc(uint64_t size, bool zero);
   bool Free(uint64_t p);
   // Returns the new address, or 0 on failure. in_place_only: fail rather
@@ -86,6 +94,50 @@ class GuestHeap {
     uint64_t requested;  // size the caller asked for (HeapSize)
   };
 
+  // ---- small-block fast path ----
+  // 64 KiB chunks, each reserved on its own (so 64 KiB aligned and apart
+  // from the segments), hold equal slots of one 16-byte size class. The
+  // requested size of every slot (+1; 0 = not live) is kept host-side.
+  static constexpr uint64_t kSmallMax = 1024;
+  static constexpr uint32_t kSmallClasses = kSmallMax / 16;
+  static constexpr uint64_t kChunkSize = 0x10000;
+  static constexpr uint32_t kShards = 8;
+  static constexpr uint32_t kTableBits = 14;
+  static constexpr size_t kTableSize = size_t(1) << kTableBits;
+  struct Chunk {
+    uint64_t base;
+    uint32_t slot_size;
+    uint32_t slots;
+    uint32_t owner;      // shard whose bump created it; frees go back there
+    uint64_t res_base;   // reservation base (== base unless aligned up)
+    std::unique_ptr<std::atomic<uint16_t>[]> req;
+  };
+  struct Bump {
+    Chunk* chunk = nullptr;
+    uint32_t next = 0;
+  };
+  struct alignas(64) Shard {
+    std::mutex mu;
+    std::vector<uint64_t> free_list[kSmallClasses];
+    Bump bump[kSmallClasses];
+  };
+  Chunk* FindChunk(uint64_t p) const;  // lock-free
+  Chunk* NewChunk(uint32_t slot_size, uint32_t owner);
+  bool EnsureSmall();  // builds shards and the table on first use
+  uint64_t SmallAlloc(uint64_t size, bool zero);
+  bool SmallFree(Chunk* c, uint64_t p);
+  uint64_t SmallReAlloc(Chunk* c, uint64_t p, uint64_t size, bool zero,
+                        bool in_place_only);
+  static uint32_t ShardIndex();
+
+  bool small_enabled_ = false;               // growable heap: fast path allowed
+  std::atomic<bool> small_ready_{false};     // shards_ and table_ are built
+  std::mutex small_init_mu_;
+  std::unique_ptr<Shard[]> shards_;
+  std::unique_ptr<std::atomic<Chunk*>[]> table_;  // open addressing, insert-only
+  std::vector<std::unique_ptr<Chunk>> chunks_;    // owns the Chunks
+  std::mutex chunk_mu_;
+
   bool Grow(uint64_t need);
   void InsertFree(uint64_t addr, uint64_t size);
   void EraseFree(uint64_t addr);
diff --git a/tests/guest_alloc_test.cpp b/tests/guest_alloc_test.cpp
index 20abc07..6ac2509 100644
--- a/tests/guest_alloc_test.cpp
+++ b/tests/guest_alloc_test.cpp
@@ -7,7 +7,16 @@
 //     and fails anywhere else;
 //   - heap sizes within 15 of 2^64 fail instead of rounding to 0.
 
+#include <algorithm>
+#include <atomic>
 #include <cstdio>
+#include <condition_variable>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <set>
+#include <thread>
+#include <vector>
 
 #include "runtime/guest_alloc.h"
 #include "runtime/guest_memory.h"
@@ -91,6 +100,170 @@ int main() {
     CHECK(heap.Free(p) && heap.Free(q));
   }
 
+  // Small-block fast path.
+  {
+    GuestAllocator vm;
+    vm.Init(&mem, kLo, kHi);
+    GuestHeap heap(vm, 0, 0);
+    // Alignment, Size() = requested size, zeroing, reuse, double free.
+    for (uint64_t n : {0u, 1u, 15u, 16u, 17u, 100u, 1023u, 1024u, 1025u, 5000u}) {
+      const uint64_t p = heap.Alloc(n, true);
+      CHECK(p && p % 16 == 0 && heap.Size(p) == n);
+      for (uint64_t i = 0; i < std::max<uint64_t>(n, 1); i++) CHECK(*mem.ptr(p + i) == 0);
+      std::memset(mem.ptr(p), 0xAB, std::max<uint64_t>(n, 1));
+      CHECK(heap.Free(p));
+      CHECK(!heap.Free(p) && heap.Size(p) == UINT64_MAX);
+      const uint64_t q = heap.Alloc(n, true);  // reused and zeroed again
+      CHECK(q && *mem.ptr(q) == 0);
+      CHECK(heap.Free(q));
+    }
+    CHECK(!heap.Free(0x1234) && heap.Size(0x1234) == UINT64_MAX);
+    // No two live blocks overlap; every live block keeps its own bytes.
+    std::vector<std::pair<uint64_t, uint64_t>> live;
+    for (int i = 0; i < 20000; i++) {
+      const uint64_t n = 1 + (i * 37) % 1100;
+      const uint64_t p = heap.Alloc(n, false);
+      CHECK(p);
+      std::memset(mem.ptr(p), i & 0xFF, n);
+      live.push_back({p, n});
+      if (i % 3 == 2) {
+        auto [fp, fn] = live[(i * 7) % live.size()];
+        CHECK(heap.Free(fp));
+        live.erase(live.begin() + (i * 7) % live.size());
+      }
+    }
+    std::set<std::pair<uint64_t, uint64_t>> spans;
+    for (auto& [p, n] : live) spans.insert({p, p + std::max<uint64_t>(n, 1)});
+    uint64_t end = 0;
+    for (auto& [b, e] : spans) { CHECK(b >= end); end = e; }
+    // Realloc: grow across the small limit, shrink, in-place-only, zero.
+    const uint64_t a = heap.Alloc(10, false);
+    std::memset(mem.ptr(a), 0x5A, 10);
+    uint64_t b = heap.ReAlloc(a, 16, true, true);  // same slot
+    CHECK(b == a && heap.Size(b) == 16 && *mem.ptr(b + 15) == 0 && *mem.ptr(b + 9) == 0x5A);
+    CHECK(heap.ReAlloc(b, 17, false, true) == 0);  // would move
+    const uint64_t g = heap.ReAlloc(b, 4000, false, false);  // small -> general
+    CHECK(g && heap.Size(g) == 4000 && *mem.ptr(g + 9) == 0x5A);
+    const uint64_t s = heap.ReAlloc(g, 40, false, false);   // general block shrinks in place
+    CHECK(s == g && heap.Size(s) == 40);
+    CHECK(heap.Free(s));
+    // A bounded heap keeps its limit and uses no chunks.
+    GuestHeap bounded(vm, 0, 0x10000);
+    uint64_t last = 0;
+    while (uint64_t p = bounded.Alloc(1024, false)) last = p;
+    CHECK(last != 0);
+  }
+  // Threads: allocate on one, free on another, from several at once.
+  {
+    GuestAllocator vm;
+    vm.Init(&mem, kLo, kHi);
+    GuestHeap heap(vm, 0, 0);
+    std::atomic<int> bad{0};
+    std::vector<std::thread> th;
+    std::vector<std::vector<uint64_t>> handoff(4);
+    for (int t = 0; t < 4; t++)
+      th.emplace_back([&, t] {
+        std::vector<uint64_t> mine;
+        for (int i = 0; i < 20000; i++) {
+          const uint64_t n = 1 + (i * 13 + t) % 600;
+          const uint64_t p = heap.Alloc(n, false);
+          if (!p || heap.Size(p) != n) bad++;
+          std::memset(mem.ptr(p), t + 1, n);
+          mine.push_back(p);
+          if (mine.size() > 64) {
+            const uint64_t q = mine[i % mine.size()];
+            if (*mem.ptr(q) != t + 1) bad++;
+            if (!heap.Free(q)) bad++;
+            mine.erase(mine.begin() + i % mine.size());
+          }
+        }
+        handoff[t] = std::move(mine);
+      });
+    for (auto& x : th) x.join();
+    // Blocks freed by a thread that did not allocate them.
+    for (int t = 0; t < 4; t++)
+      th[t] = std::thread([&, t] {
+        for (uint64_t p : handoff[(t + 1) % 4])
+          if (!heap.Free(p)) bad++;
+      });
+    for (auto& x : th) x.join();
+    CHECK(bad == 0);
+  }
+
+  // Producer/consumer: one thread only allocates, another only frees. The
+  // freed slots must come back to the producer, so the chunk count stays
+  // near the live set instead of growing every round.
+  {
+    GuestAllocator vm;
+    vm.Init(&mem, kLo, kHi);
+    GuestHeap heap(vm, 0, 0);
+    CHECK(heap.SmallChunkCountForTest() == 0);  // nothing built until used
+    constexpr int kLive = 4096, kRounds = 400;
+    std::mutex mu;
+    std::condition_variable cv;
+    std::deque<uint64_t> q;
+    std::atomic<int> bad{0};
+    std::thread cons([&] {
+      for (int n = 0; n < kLive * kRounds; n++) {
+        std::unique_lock<std::mutex> l(mu);
+        cv.wait(l, [&] { return !q.empty(); });
+        const uint64_t p = q.front();
+        q.pop_front();
+        l.unlock();
+        cv.notify_all();
+        if (!heap.Free(p)) bad++;
+      }
+    });
+    for (int n = 0; n < kLive * kRounds; n++) {
+      std::unique_lock<std::mutex> l(mu);
+      cv.wait(l, [&] { return q.size() < kLive; });
+      l.unlock();
+      const uint64_t p = heap.Alloc(48, false);
+      if (!p) { bad++; break; }
+      l.lock();
+      q.push_back(p);
+      l.unlock();
+      cv.notify_all();
+    }
+    cons.join();
+    CHECK(bad == 0);
+    // Live set is at most kLive * 48 bytes, about 4 chunks of 64 KiB.
+    const size_t chunks = heap.SmallChunkCountForTest();
+    std::printf("producer/consumer chunks: %zu\n", chunks);
+    CHECK(chunks > 0 && chunks <= 2 * (kLive * 48 / 0x10000 + 1) + 8);
+  }
+  // A double free racing from two threads succeeds exactly once.
+  {
+    GuestAllocator vm;
+    vm.Init(&mem, kLo, kHi);
+    GuestHeap heap(vm, 0, 0);
+    std::atomic<int> wins{0}, go{0};
+    for (int r = 0; r < 2000; r++) {
+      const uint64_t p = heap.Alloc(32, false);
+      go = 0;
+      std::thread a([&] { while (!go) {} if (heap.Free(p)) wins++; });
+      std::thread b([&] { while (!go) {} if (heap.Free(p)) wins++; });
+      go = 1;
+      a.join();
+      b.join();
+    }
+    CHECK(wins == 2000);
+    CHECK(!heap.Free(heap.Alloc(32, false) + 8));  // not a slot start
+  }
+  // Chunks stay 64 KiB aligned when the allocator's low bound is not.
+  {
+    GuestAllocator vm;
+    vm.Init(&mem, kLo + 0x3000, kHi);
+    GuestHeap heap(vm, 0, 0);
+    std::vector<uint64_t> v;
+    for (int i = 0; i < 5000; i++) {
+      const uint64_t p = heap.Alloc(100, false);
+      CHECK(p && heap.Size(p) == 100);
+      v.push_back(p);
+    }
+    for (uint64_t p : v) CHECK(heap.Free(p));
+  }
+
   if (g_failures) return 1;
   std::printf("guest allocator: ok\n");
   return 0;
