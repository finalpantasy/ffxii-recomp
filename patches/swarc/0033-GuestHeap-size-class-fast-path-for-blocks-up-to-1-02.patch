+// ---- small-block fast path ------------------------------------------------
+
+uint32_t GuestHeap::ShardIndex() {
+  static std::atomic<uint32_t> next{0};
+  thread_local const uint32_t id = next.fetch_add(1, std::memory_order_relaxed);
+  return id % kShards;
+}
+
+bool GuestHeap::EnsureSmall() {
+  if (small_ready_.load(std::memory_order_acquire)) return true;
+  std::lock_guard<std::mutex> l(small_init_mu_);
+  if (small_ready_.load(std::memory_order_relaxed)) return true;
+  shards_ = std::make_unique<Shard[]>(kShards);
+  table_ = std::make_unique<std::atomic<Chunk*>[]>(kTableSize);
+  for (size_t i = 0; i < kTableSize; i++)
+    table_[i].store(nullptr, std::memory_order_relaxed);
+  small_ready_.store(true, std::memory_order_release);
+  return true;
+}
+
+size_t GuestHeap::SmallChunkCountForTest() const {
+  if (!small_ready_.load(std::memory_order_acquire)) return 0;
+  std::lock_guard<std::mutex> l(const_cast<std::mutex&>(chunk_mu_));
+  return chunks_.size();
+}
+
+GuestHeap::Chunk* GuestHeap::FindChunk(uint64_t p) const {
+  if (!small_ready_.load(std::memory_order_acquire)) return nullptr;
+  const uint64_t base = p & ~(kChunkSize - 1);
+  size_t i = size_t((base >> 16) * 0x9E3779B97F4A7C15ull >> (64 - kTableBits));
+  for (size_t n = 0; n < kTableSize; n++, i = (i + 1) & (kTableSize - 1)) {
+    Chunk* c = table_[i].load(std::memory_order_acquire);
+    if (!c) return nullptr;
+    if (c->base == base) return c;
+  }
+  return nullptr;
+}
+
+GuestHeap::Chunk* GuestHeap::NewChunk(uint32_t slot_size, uint32_t owner) {
+  std::lock_guard<std::mutex> l(chunk_mu_);
+  if (chunks_.size() >= kTableSize / 2) return nullptr;  // keep probes short
+  // FindChunk masks addresses to 64 KiB, so a chunk must start on one. The
+  // allocator's lowest address can be unaligned: then reserve one extra
+  // granule and use the aligned part.
+  uint64_t res = vm_.Reserve(0, kChunkSize);
+  if (!res) return nullptr;
+  uint64_t base = res;
+  if (res & (kChunkSize - 1)) {
+    vm_.Release(res);
+    res = vm_.Reserve(0, 2 * kChunkSize);
+    if (!res) return nullptr;
+    base = RoundUp(res, kChunkSize);
+  }
+  if (!vm_.Commit(base, kChunkSize, Prot::RW)) {
+    vm_.Release(res);
+    return nullptr;
+  }
+  auto c = std::make_unique<Chunk>();
+  c->base = base;
+  c->res_base = res;
+  c->owner = owner;
+  c->slot_size = slot_size;
+  c->slots = uint32_t(kChunkSize / slot_size);
+  c->req = std::make_unique<std::atomic<uint16_t>[]>(c->slots);
+  for (uint32_t i = 0; i < c->slots; i++)
+    c->req[i].store(0, std::memory_order_relaxed);  // all free
+  Chunk* raw = c.get();
+  chunks_.push_back(std::move(c));
+  size_t i = size_t((base >> 16) * 0x9E3779B97F4A7C15ull >> (64 - kTableBits));
+  while (table_[i].load(std::memory_order_relaxed)) i = (i + 1) & (kTableSize - 1);
+  table_[i].store(raw, std::memory_order_release);
+  return raw;
+}
+
+uint64_t GuestHeap::SmallAlloc(uint64_t size, bool zero) {
+  EnsureSmall();
+  const uint32_t cls = uint32_t((std::max<uint64_t>(size, 1) + kAlign - 1) / kAlign) - 1;
+  const uint32_t slot = (cls + 1) * uint32_t(kAlign);
+  const uint32_t me = ShardIndex();
+  uint64_t p = 0;
+  Chunk* c = nullptr;
+  {
+    std::lock_guard<std::mutex> l(shards_[me].mu);
+    auto& fl = shards_[me].free_list[cls];
+    if (!fl.empty()) {
+      p = fl.back();
+      fl.pop_back();
+    }
+  }
+  if (!p) {  // steal blocks other threads freed or left behind
+    for (uint32_t k = 1; k < kShards && !p; k++) {
+      Shard& o = shards_[(me + k) % kShards];
+      std::unique_lock<std::mutex> l(o.mu, std::try_to_lock);
+      if (!l.owns_lock()) continue;
+      auto& fl = o.free_list[cls];
+      if (!fl.empty()) {
+        p = fl.back();
+        fl.pop_back();
+      }
+    }
+  }
+  if (!p) {
+    std::lock_guard<std::mutex> l(shards_[me].mu);
+    Bump& b = shards_[me].bump[cls];
+    if (!b.chunk || b.next >= b.chunk->slots) {
+      b.chunk = NewChunk(slot, me);
+      b.next = 0;
+      if (!b.chunk) return 0;  // caller falls back to the general path
+    }
+    c = b.chunk;
+    p = c->base + uint64_t(b.next++) * slot;
+  }
+  if (!c) c = FindChunk(p);
+  c->req[(p - c->base) / slot].store(uint16_t(size + 1), std::memory_order_release);
+  if (zero) std::memset(vm_.mem().ptr(p), 0, slot);
+  return p;
+}
+
+bool GuestHeap::SmallFree(Chunk* c, uint64_t p) {
+  const uint64_t off = p - c->base;
+  const uint64_t idx = off / c->slot_size;
+  if (off % c->slot_size || idx >= c->slots) return false;
+  // The exchange makes exactly one of any racing frees succeed.
+  if (!c->req[idx].exchange(0, std::memory_order_acq_rel)) return false;
+  Shard& s = shards_[c->owner];
+  std::lock_guard<std::mutex> l(s.mu);
+  s.free_list[c->slot_size / kAlign - 1].push_back(p);
+  return true;
+}
+
+uint64_t GuestHeap::SmallReAlloc(Chunk* c, uint64_t p, uint64_t size, bool zero,
+                                 bool in_place_only) {
+  const uint64_t off = p - c->base;
+  const uint64_t idx = off / c->slot_size;
+  if (off % c->slot_size || idx >= c->slots) return 0;
+  const uint16_t cur = c->req[idx].load(std::memory_order_acquire);
+  if (!cur) return 0;
+  const uint64_t old_req = uint64_t(cur) - 1;
+  if (size > UINT64_MAX - (kAlign - 1)) return 0;  // would round to 0
+  if (RoundUp(std::max<uint64_t>(size, 1), kAlign) <= c->slot_size) {
+    c->req[idx].store(uint16_t(size + 1), std::memory_order_release);  // shrink or same: keep the slot
+    if (zero && size > old_req)
+      std::memset(vm_.mem().ptr(p + old_req), 0, size - old_req);
+    return p;
+  }
+  if (in_place_only) return 0;
+  const uint64_t n = Alloc(size, zero);
+  if (!n) return 0;
+  std::memcpy(vm_.mem().ptr(n), vm_.mem().ptr(p), std::min(old_req, size));
+  Free(p);
+  return n;
+}
+
 uint64_t GuestHeap::Alloc(uint64_t size, bool zero) {
+  if (small_enabled_ && size <= kSmallMax) {
+    if (uint64_t p = SmallAlloc(size, zero)) return p;
+  }
   std::lock_guard<std::mutex> l(mu_);
   uint64_t req = size;
   if (size > UINT64_MAX - (kAlign - 1)) return 0;  // would round to 0
@@ -236,6 +397,7 @@ uint64_t GuestHeap::Alloc(uint64_t size, bool zero) {
 }
 
 bool GuestHeap::Free(uint64_t p) {
+  if (Chunk* c = FindChunk(p)) return SmallFree(c, p);
   std::lock_guard<std::mutex> l(mu_);
   auto it = used_.find(p);
   if (it == used_.end()) return false;
@@ -265,6 +427,7 @@ bool GuestHeap::Free(uint64_t p) {
 
 uint64_t GuestHeap::ReAlloc(uint64_t p, uint64_t size, bool zero,
                             bool in_place_only) {
+  if (Chunk* c = FindChunk(p)) return SmallReAlloc(c, p, size, zero, in_place_only);
   uint64_t old_req, old_size;
   {
     std::lock_guard<std::mutex> l(mu_);
@@ -303,6 +466,13 @@ uint64_t GuestHeap::ReAlloc(uint64_t p, uint64_t size, bool zero,
 }
 
 uint64_t GuestHeap::Size(uint64_t p) const {
+  if (Chunk* c = FindChunk(p)) {
+    const uint64_t off = p - c->base;
+    const uint64_t idx = off / c->slot_size;
+    if (off % c->slot_size || idx >= c->slots) return UINT64_MAX;
+    const uint16_t cur = c->req[idx].load(std::memory_order_acquire);
+    return cur ? uint64_t(cur) - 1 : UINT64_MAX;
+  }
   std::lock_guard<std::mutex> l(mu_);
   auto it = used_.find(p);
   return it == used_.end() ? UINT64_MAX : it->second.requested;
diff --git a/src/runtime/guest_alloc.h b/src/runtime/guest_alloc.h
