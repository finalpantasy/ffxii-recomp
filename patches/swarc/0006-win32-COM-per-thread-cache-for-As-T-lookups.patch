From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: finalpantasy <finalpantasy@users.noreply.github.com>
Date: Sun, 22 Nov 2026 02:11:36 -0500
Subject: [PATCH 06/34] win32 COM: per-thread cache for As<T> lookups

D3D11 forwarders resolve guest interface pointers through As<T> about
700k times a second in FFXII combat; each paid a recursive mutex, a map
lookup, a shared_ptr copy and a dynamic_cast. Each thread now keeps a
1024-entry cache per T, checked against a per-pointer generation that
Publish and the final Release bump. RECOMP_COM_STATS=1 logs the hit rate
(87.8% in FFXII combat).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 platforms/win32/src/win32/com.cpp | 26 +++++++++++++++++++++
 platforms/win32/src/win32/com.h   | 38 +++++++++++++++++++++++++++++--
 2 files changed, 62 insertions(+), 2 deletions(-)

diff --git a/platforms/win32/src/win32/com.cpp b/platforms/win32/src/win32/com.cpp
index beeb154..15d96b7 100644
--- a/platforms/win32/src/win32/com.cpp
+++ b/platforms/win32/src/win32/com.cpp
@@ -1,5 +1,7 @@
 #include "win32/com.h"
 
+#include <cstdio>
+#include <cstdlib>
 #include <cstring>
 #include <map>
 #include <mutex>
@@ -54,15 +56,38 @@ gaddr Publish(std::shared_ptr<Object> obj, gaddr vtable) {
   obj->guest = p;
   std::lock_guard<std::recursive_mutex> l(g_mu);
   g_objects[p] = std::move(obj);
+  GenerationOf(p).fetch_add(1, std::memory_order_release);
   return p;
 }
 
+std::atomic<uint32_t> g_generation[kGenSlots];
+
 std::shared_ptr<Object> Lookup(gaddr guest) {
   std::lock_guard<std::recursive_mutex> l(g_mu);
   auto it = g_objects.find(guest);
   return it == g_objects.end() ? nullptr : it->second;
 }
 
+const bool g_cache_stats = [] {
+  const char* v = std::getenv("RECOMP_COM_STATS");
+  return v && *v && *v != '0';
+}();
+
+void CountLookup(bool hit) {
+  static thread_local uint64_t calls = 0, hits = 0;
+  calls++;
+  hits += hit;
+  if ((calls & ((1u << 20) - 1)) == 0)
+    std::fprintf(stderr, "[com] cache %llu lookups, %.1f%% hits\n",
+                 static_cast<unsigned long long>(calls), 100.0 * double(hits) / double(calls));
+}
+
+Object* LookupRaw(gaddr guest) {
+  std::lock_guard<std::recursive_mutex> l(g_mu);
+  auto it = g_objects.find(guest);
+  return it == g_objects.end() ? nullptr : it->second.get();
+}
+
 uint32_t AddRef(gaddr guest) {
   std::lock_guard<std::recursive_mutex> l(g_mu);
   auto it = g_objects.find(guest);
@@ -83,6 +108,7 @@ uint32_t Release(gaddr guest) {
     if (!left) {
       dead = it->second;
       g_objects.erase(it);
+      GenerationOf(guest).fetch_add(1, std::memory_order_release);
       // Poison the guest block so a use-after-release is caught.
       Wr64(guest, 0);
       Wr32(guest + (g_proc->x64 ? 8 : 4), 0);
diff --git a/platforms/win32/src/win32/com.h b/platforms/win32/src/win32/com.h
index ab6131f..6d85dba 100644
--- a/platforms/win32/src/win32/com.h
+++ b/platforms/win32/src/win32/com.h
@@ -10,6 +10,7 @@
 // Each host object has exactly one guest pointer; QueryInterface for the
 // same interface returns it again, other interfaces are separate objects.
 
+#include <atomic>
 #include <cstdint>
 #include <memory>
 #include <string>
@@ -37,10 +38,43 @@ gaddr Publish(std::shared_ptr<Object> obj, gaddr vtable);
 // Host object behind a guest interface pointer (nullptr if not ours).
 std::shared_ptr<Object> Lookup(gaddr guest);
 
+// Raw form of Lookup: no shared_ptr copy. Like As, the pointer is valid
+// only while the guest holds a reference.
+Object* LookupRaw(gaddr guest);
+// Generations by guest-pointer hash: Publish and the final Release of a
+// pointer bump its slot, so cached lookups of that pointer are dropped.
+constexpr uint32_t kGenSlots = 4096;
+extern std::atomic<uint32_t> g_generation[kGenSlots];
+inline std::atomic<uint32_t>& GenerationOf(gaddr guest) {
+  return g_generation[(guest >> 4) & (kGenSlots - 1)];
+}
+
+// RECOMP_COM_STATS=1: each thread logs its As cache hit rate every 2^20
+// lookups.
+extern const bool g_cache_stats;
+void CountLookup(bool hit);
+
+// Host object of type T behind a guest interface pointer, or nullptr.
+// Renderers resolve the same few pointers many times a frame, so each
+// thread keeps a small cache per T, valid for one generation.
 template <typename T>
 T* As(gaddr guest) {
-  auto o = Lookup(guest);
-  return dynamic_cast<T*>(o.get());
+  struct Entry {
+    gaddr guest;
+    uint32_t gen;
+    T* host;
+  };
+  static thread_local Entry cache[1024] = {};
+  Entry& e = cache[(guest >> 4) & 1023];
+  const uint32_t gen = GenerationOf(guest).load(std::memory_order_acquire);
+  if (e.guest == guest && e.gen == gen && guest) {
+    if (g_cache_stats) CountLookup(true);
+    return e.host;
+  }
+  if (g_cache_stats) CountLookup(false);
+  T* host = dynamic_cast<T*>(LookupRaw(guest));
+  e = {guest, gen, host};
+  return host;
 }
 
 uint32_t AddRef(gaddr guest);
-- 
2.51.0.windows.1

