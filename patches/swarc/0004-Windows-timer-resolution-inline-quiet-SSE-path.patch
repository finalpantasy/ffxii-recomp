diff --git a/src/x86/sse_quiet.h b/src/x86/sse_quiet.h
new file mode 100644
index 0000000..d1d9cc7
--- /dev/null
+++ b/src/x86/sse_quiet.h
@@ -0,0 +1,196 @@
+#pragma once
+// The quiet fast path of SSE arithmetic on x86-64 hosts, inline in the
+// generated code (see sse.h; sse.cpp holds the full paths).
+//
+// The quiet case runs the guest's instruction as itself with no MXCSR
+// switch (LDMXCSR is microcoded and slow on AMD Zen): every lane's operands
+// and result are zero or normal, so DAZ and FTZ change nothing and no IE,
+// DE, ZE, OE or UE can arise; PE is already set in the guest's flags
+// (arithmetic and square root; MIN/MAX raise none); and guest and host
+// both round to nearest with every exception masked (the host is checked
+// every 4096 uses). Lanes are classified with integer code; only the lanes
+// the instruction writes count (lane 0 for scalar forms).
+
+#include <cstdint>
+#include <cstring>
+#include <type_traits>
+
+#include "x86/ctx.h"
+
+namespace recomp::sse {
+
+enum Op : uint8_t { kAdd, kSub, kMul, kDiv };
+
+#if defined(__x86_64__)
+// False under RECOMP_SOFT_SSE=1: everything goes the SoftFloat way.
+extern const bool kNativeSse;
+
+namespace quiet {
+
+typedef float V4 __attribute__((vector_size(16)));
+
+inline bool HostRoundsNearest() {
+  static thread_local uint32_t uses = 0, ok = 0;
+  if ((uses++ & 4095) == 0) {
+    uint32_t h;
+    asm volatile("stmxcsr %0" : "=m"(h));
+    ok = (h & 0x7F80) == 0x1F80;
+  }
+  return ok;
+}
+
+inline bool Ok(const Ctx& c, bool need_pe) {
+  return kNativeSse && (c.mxcsr & 0x7F80) == 0x1F80 && (!need_pe || (c.mxcsr & 0x20)) &&
+         HostRoundsNearest();
+}
+
+// Per-lane classes as bit masks (bit i: lane i).
+template <bool D>
+struct Lanes {
+  using U = std::conditional_t<D, uint64_t, uint32_t>;
+  static constexpr int kN = D ? 2 : 4;
+  static constexpr U kExp = D ? U(0x7FF0000000000000ull) : U(0x7F800000u);
+  static constexpr U kFrac = D ? U(0x000FFFFFFFFFFFFFull) : U(0x007FFFFFu);
+  U v[kN];
+  explicit Lanes(const void* p) { std::memcpy(v, p, 16); }
+  // NaN, infinite or denormal.
+  unsigned Special(int n) const {
+    unsigned m = 0;
+    for (int i = 0; i < n; i++) {
+      const U e = v[i] & kExp;
+      m |= unsigned(e == kExp || (e == 0 && (v[i] & kFrac))) << i;
+    }
+    return m;
+  }
+  unsigned Zero(int n) const {
+    unsigned m = 0;
+    for (int i = 0; i < n; i++) m |= unsigned(U(v[i] << 1) == 0) << i;
+    return m;
+  }
+  unsigned Neg(int n) const {
+    unsigned m = 0;
+    for (int i = 0; i < n; i++) m |= unsigned(v[i] >> (sizeof(U) * 8 - 1)) << i;
+    return m;
+  }
+};
+
+#define RECOMP_SSE_BARE(dv, sv, insn) asm(insn " %1, %0" : "+x"(dv) : "x"(sv))
+#define RECOMP_SSE_BARE2(dv, sv, dbl, sgl) \
+  do {                                     \
+    if constexpr (D)                       \
+      RECOMP_SSE_BARE(dv, sv, dbl);        \
+    else                                   \
+      RECOMP_SSE_BARE(dv, sv, sgl);        \
+  } while (0)
+
+template <bool D>
+[[gnu::always_inline]] inline bool Arith(Op op, bool scalar, Xmm& d, const Xmm& s) {
+  const int n = scalar ? 1 : Lanes<D>::kN;
+  const Lanes<D> a(d.b), b(s.b);
+  if (a.Special(n) | b.Special(n)) return false;
+  if (op == kDiv && b.Zero(n)) return false;  // ZE, or 0/0
+  V4 r, sv;
+  std::memcpy(&r, d.b, 16);
+  std::memcpy(&sv, s.b, 16);
+  switch (op << 1 | int(scalar)) {
+    case kAdd << 1 | 0: RECOMP_SSE_BARE2(r, sv, "addpd", "addps"); break;
+    case kAdd << 1 | 1: RECOMP_SSE_BARE2(r, sv, "addsd", "addss"); break;
+    case kSub << 1 | 0: RECOMP_SSE_BARE2(r, sv, "subpd", "subps"); break;
+    case kSub << 1 | 1: RECOMP_SSE_BARE2(r, sv, "subsd", "subss"); break;
+    case kMul << 1 | 0: RECOMP_SSE_BARE2(r, sv, "mulpd", "mulps"); break;
+    case kMul << 1 | 1: RECOMP_SSE_BARE2(r, sv, "mulsd", "mulss"); break;
+    case kDiv << 1 | 0: RECOMP_SSE_BARE2(r, sv, "divpd", "divps"); break;
+    default: RECOMP_SSE_BARE2(r, sv, "divsd", "divss"); break;
+  }
+  // Overflow (infinity) or a denormal result; a product or quotient of
+  // nonzero operands that came out zero underflowed.
+  const Lanes<D> o(&r);
+  if (o.Special(n) || (op >= kMul && (o.Zero(n) & ~(a.Zero(n) | b.Zero(n))))) return false;
+  std::memcpy(d.b, &r, 16);
+  return true;
+}
+
+template <bool D>
+[[gnu::always_inline]] inline bool Sqrt(bool scalar, Xmm& d, const Xmm& s) {
+  const int n = scalar ? 1 : Lanes<D>::kN;
+  const Lanes<D> b(s.b);
+  // Special operands, and negative nonzero ones (invalid).
+  if (b.Special(n) | (b.Neg(n) & ~b.Zero(n))) return false;
+  V4 dv, sv;
+  std::memcpy(&dv, d.b, 16);
+  std::memcpy(&sv, s.b, 16);
+  if (scalar)
+    RECOMP_SSE_BARE2(dv, sv, "sqrtsd", "sqrtss");
+  else
+    RECOMP_SSE_BARE2(dv, sv, "sqrtpd", "sqrtps");
+  std::memcpy(d.b, &dv, 16);
+  return true;
+}
+
+template <bool D>
+[[gnu::always_inline]] inline bool MinMax(bool max, bool scalar, Xmm& d, const Xmm& s) {
+  const int n = scalar ? 1 : Lanes<D>::kN;
+  if (Lanes<D>(d.b).Special(n) | Lanes<D>(s.b).Special(n)) return false;
+  V4 dv, sv;
+  std::memcpy(&dv, d.b, 16);
+  std::memcpy(&sv, s.b, 16);
+  switch (int(max) << 1 | int(scalar)) {
+    case 0: RECOMP_SSE_BARE2(dv, sv, "minpd", "minps"); break;
+    case 1: RECOMP_SSE_BARE2(dv, sv, "minsd", "minss"); break;
+    case 2: RECOMP_SSE_BARE2(dv, sv, "maxpd", "maxps"); break;
+    default: RECOMP_SSE_BARE2(dv, sv, "maxsd", "maxss"); break;
+  }
+  std::memcpy(d.b, &dv, 16);
+  return true;
+}
+
+#undef RECOMP_SSE_BARE2
+#undef RECOMP_SSE_BARE
+
+inline bool KnownLanes(bool dbl, int lanes) { return lanes == 1 || lanes == (dbl ? 2 : 4); }
+
+}  // namespace quiet
+#endif
+
+// The full paths (native with the guest's MXCSR, or SoftFloat), in sse.cpp.
+void ArithSlow(Ctx& c, Op op, bool dbl, int lanes, Xmm& d, const Xmm& s, uint64_t va);
+void SqrtSlow(Ctx& c, bool dbl, int lanes, Xmm& d, const Xmm& s, uint64_t va);
+void MinMaxSlow(Ctx& c, bool max, bool dbl, int lanes, Xmm& d, const Xmm& s, uint64_t va);
+
+// d = d op s, lane-wise: `lanes` lanes of double (dbl) or float. Scalar
+// forms pass lanes = 1 and keep the upper lanes of d.
+inline void Arith(Ctx& c, Op op, bool dbl, int lanes, Xmm& d, const Xmm& s, uint64_t va) {
+#if defined(__x86_64__)
+  if (quiet::KnownLanes(dbl, lanes) && quiet::Ok(c, true) &&
+      (dbl ? quiet::Arith<true>(op, lanes == 1, d, s) : quiet::Arith<false>(op, lanes == 1, d, s)))
+    return;
+#endif
+  ArithSlow(c, op, dbl, lanes, d, s, va);
+}
+
+// SQRTSD/SQRTSS/SQRTPD/SQRTPS: d = sqrt(s), lane-wise; scalar forms keep
+// the upper lanes of d.
+inline void Sqrt(Ctx& c, bool dbl, int lanes, Xmm& d, const Xmm& s, uint64_t va) {
+#if defined(__x86_64__)
+  if (quiet::KnownLanes(dbl, lanes) && quiet::Ok(c, true) &&
+      (dbl ? quiet::Sqrt<true>(lanes == 1, d, s) : quiet::Sqrt<false>(lanes == 1, d, s)))
+    return;
+#endif
+  SqrtSlow(c, dbl, lanes, d, s, va);
+}
+
+// MINSS/SD/PS/PD (max = false) and MAXSS/SD/PS/PD, lane-wise: d op s ? d : s.
+// A NaN in either operand (invalid, quiet ones too) or equal values,
+// zeros of either sign included, give s. Scalar forms keep d's upper lanes.
+inline void MinMax(Ctx& c, bool max, bool dbl, int lanes, Xmm& d, const Xmm& s,
+                   uint64_t va) {
+#if defined(__x86_64__)
+  if (quiet::KnownLanes(dbl, lanes) && quiet::Ok(c, false) &&
+      (dbl ? quiet::MinMax<true>(max, lanes == 1, d, s)
+           : quiet::MinMax<false>(max, lanes == 1, d, s)))
+    return;
+#endif
+  MinMaxSlow(c, max, dbl, lanes, d, s, va);
+}
+
+}  // namespace recomp::sse
