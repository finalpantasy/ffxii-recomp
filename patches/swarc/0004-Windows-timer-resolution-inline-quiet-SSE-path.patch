+// Timed waits (Sleep, event and condition-variable timeouts) otherwise
+// round up to the 15.6 ms system tick, which breaks 60 fps frame pacing.
+// Windows 11 drops a process's resolution request while its windows are
+// hidden or occluded unless told to keep it.
+const int kTimerResolution = [] {
+  PROCESS_POWER_THROTTLING_STATE s = {};
+  s.Version = PROCESS_POWER_THROTTLING_CURRENT_VERSION;
+  s.ControlMask = PROCESS_POWER_THROTTLING_IGNORE_TIMER_RESOLUTION;
+  s.StateMask = 0;
+  SetProcessInformation(GetCurrentProcess(), ProcessPowerThrottling, &s, sizeof s);
+  timeBeginPeriod(1);
+  return 0;
+}();
 }  // namespace
 
