 #include "win32/kernel32_state.h"
@@ -1308,7 +1309,17 @@ HLE("winmm.dll", midiInClose, 1) { return 5; }
 // with Sleep in the loop.
 HLE64("kernel32.dll", Sleep, 1) {
   GuestSyncPoint sync;
+#if defined(_WIN32)
+  // The host's high-resolution timer: the CRT's sleep_for rounds up to
+  // the system tick.
+  const uint32_t ms = Arg(c, 0);
+  if (ms == 0)
+    std::this_thread::yield();
+  else
+    platform::SleepUntilNs(platform::MonotonicNs() + uint64_t(ms) * 1000000);
+#else
   std::this_thread::sleep_for(std::chrono::milliseconds(Arg(c, 0)));
+#endif
   return 0;
 }
 
