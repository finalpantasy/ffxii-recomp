@@ -37,6 +37,7 @@ class Emitter {
                   std::set<uint64_t>* refs, EmitStats* stats) const;
   const Program& p_;
   const Decoder& dec_;
+  std::map<uint64_t, uint32_t> entry_index_;  // entry -> index in p_.entries
 };
 
 }  // namespace lifter
