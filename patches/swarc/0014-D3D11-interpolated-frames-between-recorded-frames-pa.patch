+void DrainDebugMessages() {
+#ifdef _WIN32
+  if (!g_rec.info) return;
+  static std::unordered_map<int, int> seen;
+  const UINT64 n = g_rec.info->GetNumStoredMessages();
+  for (UINT64 i = 0; i < n; ++i) {
+    SIZE_T len = 0;
+    if (FAILED(g_rec.info->GetMessage(i, nullptr, &len)) || !len) continue;
+    std::vector<uint8_t> buf(len);
+    auto* m = reinterpret_cast<D3D11_MESSAGE*>(buf.data());
+    if (FAILED(g_rec.info->GetMessage(i, m, &len))) continue;
+    if (++seen[int(m->ID)] > 3) continue;
+    std::fprintf(stderr, "[d3d11-debug] frame %llu sev %d id %d: %.*s\n",
+                 (unsigned long long)g_rec.frames, int(m->Severity), int(m->ID),
+                 int(m->DescriptionByteLength), m->pDescription);
+  }
+  g_rec.info->ClearStoredMessages();
+#endif
+}
