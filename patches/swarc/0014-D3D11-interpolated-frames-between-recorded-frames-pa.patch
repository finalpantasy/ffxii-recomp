+namespace {
+// Interpolated frames are paced by a presenter thread: it shows the blended
+// frame when the game presents, then the real frame half a frame interval
+// later, so the two are evenly spaced. FFXII_D3D_PACE=0 presents both at once.
+struct Presenter {
+  std::mutex mu;
+  std::condition_variable cv;
+  bool busy = false;
+  IDXGISwapChain* swap = nullptr;
+  ID3D11CommandList* blend = nullptr;
+  ID3D11CommandList* main = nullptr;
+  bool show_blend = false;
+  uint32_t interval = 0, flags = 0;
+  double half_ns = 8.33e6;  // half the measured frame interval
+  std::chrono::steady_clock::time_point last;
+  uint64_t frames = 0, late = 0;
+};
+Presenter g_pres;
+
+void PresenterLoop() {
+  static const bool dump_blend = Env("DUMP_BLENDED") != nullptr;
+  for (;;) {
+    std::unique_lock<std::mutex> lock(g_pres.mu);
+    g_pres.cv.wait(lock, [] { return g_pres.busy; });
+    IDXGISwapChain* swap = g_pres.swap;
+    ID3D11CommandList* blend = g_pres.blend;
+    ID3D11CommandList* main = g_pres.main;
+    const bool show = g_pres.show_blend;
+    const uint32_t interval = g_pres.interval, flags = g_pres.flags;
+    const auto half = std::chrono::nanoseconds(int64_t(g_pres.half_ns));
+    lock.unlock();
+    const auto t0 = std::chrono::steady_clock::now();
+    {
+      std::lock_guard<std::recursive_mutex> imm(D3d11ImmediateLock());
+      D3d11Execute(blend);
+      if (show) {
+        if (dump_blend) DumpFrame(swap);
+        swap->Present(0, flags);
+      }
+    }
+    if (show) {
+      if (std::chrono::steady_clock::now() > t0 + half) ++g_pres.late;
+      std::this_thread::sleep_until(t0 + half);
+    }
+    {
+      std::lock_guard<std::recursive_mutex> imm(D3d11ImmediateLock());
+      D3d11Execute(main);
+      if (!dump_blend) DumpFrame(swap);
+      swap->Present(interval, flags);
+    }
+    swap->Release();
+    lock.lock();
+    g_pres.busy = false;
+    lock.unlock();
+    g_pres.cv.notify_all();
+  }
+}
+
+void PresenterWaitIdle() {
+  std::unique_lock<std::mutex> lock(g_pres.mu);
+  g_pres.cv.wait(lock, [] { return !g_pres.busy; });
+}
+
+bool PacingOn() {
+  static const bool on = [] {
+    const char* v = Env("D3D_PACE");
+    return Env("D3D_INTERP") && !(v && v[0] == '0');
+  }();
+  return on;
+}
+}  // namespace
+
