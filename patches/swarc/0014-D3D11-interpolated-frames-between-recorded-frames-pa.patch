   IDXGISwapChain* swap = DxvkHost<IDXGISwapChain>(Arg(c, 0));
+  static const bool dump_blend = Env("DUMP_BLENDED") != nullptr;
+  if (PacingOn()) {
+    static std::thread thread = [] {
+      std::thread t(PresenterLoop);
+      t.detach();
+      return t;
+    }();
+    PresenterWaitIdle();
+    bool show = false;
+    ID3D11CommandList* blend = D3d11FinishBlended(&show);
+    ID3D11CommandList* main = D3d11FinishMain();
+    const auto now = std::chrono::steady_clock::now();
+    std::lock_guard<std::mutex> lock(g_pres.mu);
+    if (g_pres.frames++) {
+      const double dt = double(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                   now - g_pres.last).count());
+      // Half of a smoothed frame interval, kept between 2 and 25 ms.
+      const double h = std::min(25e6, std::max(2e6, dt * 0.5));
