From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: finalpantasy <finalpantasy@users.noreply.github.com>
Date: Sun, 22 Nov 2026 15:56:54 -0500
Subject: [PATCH 20/34] Lifter hook directive, SetProbeHook, game clock for
 test scripts

- Manifest `hook <VA> <name>`: a probe call before the instruction that
  does not make VA an entry, so the function stays whole.
- x86/probe_hook.h: SetProbeHook lets a game handle probes (adjust
  registers or memory at one instruction). Kept out of lifted.h so that
  adding it does not rebuild every generated file.
- input_state.h SetTestClock: TEST_INPUT scripts can follow a game clock
  instead of wall time.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 platforms/win32/src/win32/input_state.h     |  8 ++++++++
 platforms/win32/src/win32/user32_window.cpp | 13 ++++++++++---
 src/x86/dispatch.cpp                        |  8 ++++++++
 src/x86/probe_hook.h                        | 15 +++++++++++++++
 tools/lifter_x86/program.cpp                |  6 ++++++
 5 files changed, 47 insertions(+), 3 deletions(-)
 create mode 100644 src/x86/probe_hook.h

diff --git a/platforms/win32/src/win32/input_state.h b/platforms/win32/src/win32/input_state.h
index 63d7d6a..f047fe3 100644
--- a/platforms/win32/src/win32/input_state.h
+++ b/platforms/win32/src/win32/input_state.h
@@ -74,4 +74,12 @@ bool GetTestPad(TestPadState* out);
 using TestCondition = bool (*)(const char* arg, double waited, float* lx, float* ly, uint16_t* buttons);
 void RegisterTestCondition(const char* name, TestCondition fn);
 
+// The clock of <ID>_TEST_INPUT scripts, in seconds. By default it is wall
+// time. A game can set its own (game time, which also stands still while
+// the game is slow or loading), so a script reaches the same game moments
+// at any frame rate or machine load. Set it before the first event pump;
+// script time 0 is the clock's value at that pump.
+using TestClock = double (*)();
+void SetTestClock(TestClock fn);
+
 }  // namespace recomp
diff --git a/platforms/win32/src/win32/user32_window.cpp b/platforms/win32/src/win32/user32_window.cpp
index 71a1c76..43d14c8 100644
--- a/platforms/win32/src/win32/user32_window.cpp
+++ b/platforms/win32/src/win32/user32_window.cpp
@@ -939,6 +939,13 @@ struct TestWait {
 
 void RegisterTestCondition(const char* name, TestCondition fn) { TestConditions()[name] = fn; }
 
+namespace {
+TestClock g_test_clock = nullptr;
+// Milliseconds on the test-script clock: the game's clock when one is set.
+Uint64 TestClockMs() { return g_test_clock ? Uint64(g_test_clock() * 1000.0) : SDL_GetTicks(); }
+}  // namespace
+void SetTestClock(TestClock fn) { g_test_clock = fn; }
+
 namespace {
 
 void InjectTestInput() {
@@ -949,14 +956,14 @@ void InjectTestInput() {
   static std::vector<TestWait> waits;
   static size_t wnext = 0;
   static double held = 0;        // seconds the script clock has stood still
-  static double wait_since = -1;  // real time the current wait began
+  static double wait_since = -1;  // clock time the current wait began
   static bool steering = false;   // a condition drives the left stick
   static TestPadState pad;
   static Uint64 t0 = 0;
   static bool loaded = false;
   if (!loaded) {
     loaded = true;
-    t0 = SDL_GetTicks();
+    t0 = TestClockMs();
     const char* path = Env("TEST_INPUT");
     if (!path) return;
     FILE* f = std::fopen(path, "r");
@@ -1091,7 +1098,7 @@ void InjectTestInput() {
     // The pad is plugged in from the start (a wait may steer it).
     if (!pq.empty() || !waits.empty()) SetTestPad(pad);
   }
-  const double now = (SDL_GetTicks() - t0) / 1000.0;
+  const double now = (TestClockMs() - t0) / 1000.0;
   double t = now - held;
   // A pending wait holds the script clock at its time until it is met.
   while (wnext < waits.size() && t >= waits[wnext].t) {
