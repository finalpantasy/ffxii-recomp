diff --git a/src/x86/probe_hook.h b/src/x86/probe_hook.h
new file mode 100644
index 0000000..5757423
--- /dev/null
+++ b/src/x86/probe_hook.h
@@ -0,0 +1,15 @@
+#pragma once
+// Game hook for manifest probes (`probe <VA> [name]` lines). A probe runs
+// before the instruction at VA, with registers spilled to Ctx and reloaded
+// afterwards, so the hook can log or correct register and memory state at
+// that one instruction. It returns true when it handled the probe, false
+// for the default log line. Kept out of lifted.h so that adding it does not
+// rebuild every generated file.
+
+#include <cstdint>
+
+namespace recomp {
+struct Ctx;
+using ProbeHook = bool (*)(Ctx& c, uint64_t va, const char* name);
+void SetProbeHook(ProbeHook hook);
+}  // namespace recomp
diff --git a/tools/lifter_x86/program.cpp b/tools/lifter_x86/program.cpp
index 770c6df..c76546a 100644
--- a/tools/lifter_x86/program.cpp
+++ b/tools/lifter_x86/program.cpp
@@ -193,6 +193,12 @@ bool Program::LoadManifest(const std::string& path, std::string* err) {
     } else if (kind == "probe") {
       entries.insert(va);
       probes[va] = name.empty() ? "probe" : name;
+    } else if (kind == "hook") {
+      // hook <VA> <name>: the same call as a probe (::recomp::Probe before
+      // the instruction, for a game's SetProbeHook), without making VA an
+      // entry, so the function stays whole and the call costs only a
+      // register spill and reload where it sits.
+      probes[va] = name.empty() ? "hook" : name;
     } else if (kind == "replace") {
       entries.insert(va);
       replaced.insert(va);
