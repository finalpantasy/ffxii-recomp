index bd3ea50..76c6156 100644
--- a/platforms/win32/src/win32/dxvk.h
+++ b/platforms/win32/src/win32/dxvk.h
@@ -23,7 +23,6 @@ struct DxvkObject : com::Object {
   std::map<uint32_t, DxvkMapping> mappings;
   // Frame recording: the last full contents of a dynamic buffer, and the
   // command list (serial) in which it was last mapped with WRITE_DISCARD.
-  std::vector<uint8_t> mirror;
   uint64_t discard_list = 0;
   uint64_t blend_discard_list = 0;  // the same for the interpolation context
 
