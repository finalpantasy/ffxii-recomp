diff --git a/platforms/win32/src/win32/host_compat.h b/platforms/win32/src/win32/host_compat.h
new file mode 100644
index 0000000..3a41f7d
--- /dev/null
+++ b/platforms/win32/src/win32/host_compat.h
@@ -0,0 +1,60 @@
+#pragma once
+// Host differences the Win32 HLE modules meet, force-included into every
+// file of platforms/win32 (CMakeLists.txt). POSIX hosts get the helpers
+// only; Windows hosts (MinGW-w64 UCRT) also get the POSIX calls the HLE
+// file and time code uses.
+
+#include <ctime>
+#include <string>
+
+#if defined(_WIN32)
+#include <direct.h>
+#include <fcntl.h>
+#include <io.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#ifndef O_CLOEXEC
+#define O_CLOEXEC 0
+#endif
+
+inline std::tm* localtime_r(const std::time_t* t, std::tm* out) {
+  return localtime_s(out, t) == 0 ? out : nullptr;
+}
+inline std::tm* gmtime_r(const std::time_t* t, std::tm* out) {
+  return gmtime_s(out, t) == 0 ? out : nullptr;
+}
+inline std::time_t timegm(std::tm* t) { return _mkgmtime(t); }
+inline int fsync(int fd) { return _commit(fd); }
+inline int mkdir(const char* path, int /*mode*/) { return _mkdir(path); }
+inline int setenv(const char* name, const char* value, int overwrite) {
+  if (!overwrite && std::getenv(name)) return 0;
+  return _putenv_s(name, value);
+}
+inline int unsetenv(const char* name) { return _putenv_s(name, ""); }
+#endif
+
+namespace recomp::host {
+
+// Seconds east of UTC for the broken-down local time t (tm_gmtoff).
+inline long GmtOff(const std::tm& t) {
+#if defined(_WIN32)
+  std::tm a = t, b = t;
+  b.tm_isdst = t.tm_isdst;
+  return long(_mkgmtime(&a) - std::mktime(&b));
+#else
+  return t.tm_gmtoff;
+#endif
+}
+
+// The time zone's abbreviation for t (tm_zone), or nullptr.
+inline const char* ZoneName(const std::tm& t) {
+#if defined(_WIN32)
+  return _tzname[t.tm_isdst > 0 ? 1 : 0];
+#else
+  return t.tm_zone;
+#endif
+}
+
+}  // namespace recomp::host
