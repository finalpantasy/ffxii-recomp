diff --git a/src/runtime/platform_win.cpp b/src/runtime/platform_win.cpp
new file mode 100644
index 0000000..3cf072d
--- /dev/null
+++ b/src/runtime/platform_win.cpp
@@ -0,0 +1,205 @@
+// Host platform specifics for Windows (x86-64); see platform.h.
+// Faults arrive through a vectored exception handler (dispatch.cpp), so
+// `uc` here is the handler's EXCEPTION_POINTERS.
+
+#include "runtime/platform.h"
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+#include <fcntl.h>
+#include <stdlib.h>
+
+#include <cstdlib>
+
+namespace recomp::platform {
+
+namespace {
+// The CRT opens files in text mode by default, which would translate line
+// ends in every game file: make binary the default for open() and fopen().
+const int kBinaryFiles = (_set_fmode(_O_BINARY), 0);
+}  // namespace
+
+size_t PageSize() {
+  SYSTEM_INFO si;
+  GetSystemInfo(&si);
+  return si.dwPageSize;
+}
+
+void* VmReserve(void* hint, size_t size) {
+  void* p = hint ? VirtualAlloc(hint, size, MEM_RESERVE, PAGE_NOACCESS) : nullptr;
+  if (!p) p = VirtualAlloc(nullptr, size, MEM_RESERVE, PAGE_NOACCESS);
+  return p;
+}
+
+bool VmSetAccess(void* p, size_t size, Access a) {
+  // Committing pages already committed keeps their contents and only sets
+  // the protection; fresh commits read zero. Inaccessible pages stay
+  // committed so their contents survive (write watches, lazy regions).
+  const DWORD prot = a == Access::ReadWrite ? PAGE_READWRITE
+                     : a == Access::Read    ? PAGE_READONLY
+                                            : PAGE_NOACCESS;
+  return VirtualAlloc(p, size, MEM_COMMIT, prot) != nullptr;
+}
+
+void VmDiscard(void* p, size_t size) { VirtualFree(p, size, MEM_DECOMMIT); }
+
+std::string ExeDir() {
+  wchar_t w[MAX_PATH * 2];
+  const DWORD n = GetModuleFileNameW(nullptr, w, DWORD(sizeof w / sizeof w[0]));
+  char u[MAX_PATH * 6];
+  const int m = WideCharToMultiByte(CP_UTF8, 0, w, int(n), u, int(sizeof u), nullptr, nullptr);
+  std::string s(u, size_t(m > 0 ? m : 0));
+  for (char& ch : s)
+    if (ch == '\\') ch = '/';
+  const size_t slash = s.rfind('/');
+  return slash == std::string::npos ? "." : s.substr(0, slash);
+}
+
+// ---- time
+
+uint64_t MonotonicNs() {
+  static const uint64_t freq = [] {
+    LARGE_INTEGER f;
+    QueryPerformanceFrequency(&f);
+    return uint64_t(f.QuadPart);
+  }();
+  LARGE_INTEGER c;
+  QueryPerformanceCounter(&c);
+  const uint64_t t = uint64_t(c.QuadPart);
+  return t / freq * 1000000000ull + t % freq * 1000000000ull / freq;
+}
+
+void SleepUntilNs(uint64_t t) {
+  // A high-resolution waitable timer wakes within about 0.5 ms; the rest
+  // is a short spin with yields.
+  static thread_local HANDLE timer =
+      CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                             TIMER_ALL_ACCESS);
+  for (;;) {
+    const uint64_t now = MonotonicNs();
+    if (now >= t) return;
+    const uint64_t left = t - now;
+    if (left > 600000 && timer) {
+      LARGE_INTEGER due;
+      due.QuadPart = -int64_t((left - 500000) / 100);  // relative, 100 ns units
+      if (SetWaitableTimerEx(timer, &due, 0, nullptr, nullptr, nullptr, 0)) {
+        WaitForSingleObject(timer, INFINITE);
+        continue;
+      }
+    }
+    if (left > 600000) {
+      Sleep(DWORD(left / 1000000));
+      continue;
+    }
+    SwitchToThread();
+  }
+}
+
+// ---- stacks
+// Fibers bring stacks of their own (the TEB's stack bounds then match,
+// which SEH unwinding checks), so the caller's stack is not used.
+
+namespace {
+void (*t_stack_fn)() = nullptr;
+void* t_caller_fiber = nullptr;
+
+void WINAPI StackFiber(void*) {
+  t_stack_fn();
+  SwitchToFiber(t_caller_fiber);
+}
+}  // namespace
+
+void RunOnStack(void* stack, size_t size, void (*fn)()) {
+  (void)stack;
+  const bool was_fiber = IsThreadAFiber();
+  t_caller_fiber = was_fiber ? GetCurrentFiber() : ConvertThreadToFiber(nullptr);
+  if (!t_caller_fiber) std::abort();
+  t_stack_fn = fn;
+  void* f = CreateFiberEx(64 << 10, size, FIBER_FLAG_FLOAT_SWITCH, StackFiber, nullptr);
+  if (!f) std::abort();
+  SwitchToFiber(f);
+  DeleteFiber(f);
+  if (!was_fiber) ConvertFiberToThread();
+}
+
+struct Coroutine {
+  void* fiber = nullptr;
+  void (*fn)(void*) = nullptr;
+  void* arg = nullptr;
+  bool thread_own = false;
+};
+
+namespace {
+void WINAPI CoroutineStart(void* p) {
+  auto* c = static_cast<Coroutine*>(p);
+  c->fn(c->arg);
+  std::abort();  // fn must not return
+}
+}  // namespace
+
+Coroutine* NewCoroutine(void* stack, size_t size, void (*fn)(void*), void* arg) {
+  (void)stack;
+  auto* c = new Coroutine;
+  c->fn = fn;
+  c->arg = arg;
+  c->fiber = CreateFiberEx(64 << 10, size, FIBER_FLAG_FLOAT_SWITCH, CoroutineStart, c);
+  if (!c->fiber) std::abort();
+  return c;
+}
+
+Coroutine* ThreadCoroutine() {
+  auto* c = new Coroutine;
+  c->thread_own = true;
+  c->fiber = IsThreadAFiber() ? GetCurrentFiber() : ConvertThreadToFiber(nullptr);
+  return c;
+}
+
+void SwitchCoroutine(Coroutine* from, Coroutine* to) {
+  (void)from;
+  SwitchToFiber(to->fiber);
+}
+
+void FreeCoroutine(Coroutine* c) {
+  if (!c->thread_own && c->fiber) DeleteFiber(c->fiber);
+  delete c;
+}
+
+// ---- faults
+
+FaultContext ReadFaultContext(const void* uc) {
+  FaultContext f;
+  const auto* ep = static_cast<const EXCEPTION_POINTERS*>(uc);
+  const EXCEPTION_RECORD* er = ep->ExceptionRecord;
+  const CONTEXT* cx = ep->ContextRecord;
+  if (er->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && er->NumberParameters >= 2) {
+    f.write_known = true;
+    f.write = er->ExceptionInformation[0] == 1;  // 0 read, 1 write, 8 execute
+  }
+  f.pc = uintptr_t(cx->Rip);
+  f.caller = *reinterpret_cast<const uintptr_t*>(cx->Rsp);
+  return f;
+}
+
+namespace {
+thread_local void (*t_redirected)() = nullptr;
+
+[[noreturn]] __attribute__((force_align_arg_pointer, noinline)) void CallRedirected() {
+  void (*fn)() = t_redirected;
+  t_redirected = nullptr;
+  fn();
+  std::abort();  // fn must not return
+}
+}  // namespace
+
+bool RedirectToCall(void* uc, void (*fn)()) {
+  CONTEXT* cx = static_cast<EXCEPTION_POINTERS*>(uc)->ContextRecord;
+  // A call's push. Windows x64 has no red zone, so nothing lives there.
+  cx->Rsp -= 8;
+  *reinterpret_cast<uint64_t*>(cx->Rsp) = cx->Rip + 1;
+  cx->Rip = reinterpret_cast<uintptr_t>(&CallRedirected);
+  t_redirected = fn;
+  return true;
+}
+
+}  // namespace recomp::platform
