@@ -32,6 +39,42 @@ struct Adapter {
 
 // The host's Ethernet-like interfaces that have a hardware address
 // (loopback and tunnels have none), in interface-index order.
+#if defined(_WIN32)
+std::vector<Adapter> HostAdapters() {
+  std::vector<Adapter> out;
+  ULONG size = 16 << 10;
+  std::vector<uint8_t> buf(size);
+  auto* list = reinterpret_cast<IP_ADAPTER_ADDRESSES*>(buf.data());
+  ULONG r = GetAdaptersAddresses(AF_INET, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST |
+                                     GAA_FLAG_SKIP_DNS_SERVER, nullptr, list, &size);
+  if (r == ERROR_BUFFER_OVERFLOW) {
+    buf.resize(size);
+    list = reinterpret_cast<IP_ADAPTER_ADDRESSES*>(buf.data());
+    r = GetAdaptersAddresses(AF_INET, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST |
+                                 GAA_FLAG_SKIP_DNS_SERVER, nullptr, list, &size);
+  }
+  if (r != NO_ERROR) return out;
+  for (auto* i = list; i; i = i->Next) {
+    if (i->PhysicalAddressLength != 6 || i->IfType == IF_TYPE_SOFTWARE_LOOPBACK) continue;
+    if (i->IfType != IF_TYPE_ETHERNET_CSMACD && i->IfType != IF_TYPE_IEEE80211) continue;
+    Adapter a;
+    a.name = i->AdapterName;
+    a.index = i->IfIndex;
+    std::memcpy(a.mac, i->PhysicalAddress, 6);
+    a.wireless = i->IfType == IF_TYPE_IEEE80211;
+    for (auto* u = i->FirstUnicastAddress; u; u = u->Next) {
+      if (u->Address.lpSockaddr->sa_family != AF_INET) continue;
+      a.ip = reinterpret_cast<const sockaddr_in*>(u->Address.lpSockaddr)->sin_addr.s_addr;
+      const uint8_t bits = u->OnLinkPrefixLength;
+      a.mask = bits ? htonl(uint32_t(0xFFFFFFFFull << (32 - bits))) : 0;
+      break;
+    }
+    out.push_back(a);
+  }
+  std::sort(out.begin(), out.end(), [](const Adapter& x, const Adapter& y) { return x.index < y.index; });
+  return out;
+}
+#else
 std::vector<Adapter> HostAdapters() {
   std::vector<Adapter> out;
   ifaddrs* list = nullptr;
@@ -65,6 +108,7 @@ std::vector<Adapter> HostAdapters() {
   freeifaddrs(list);
   return out;
 }
+#endif
 
