new file mode 100644
index 0000000..4a95150
--- /dev/null
+++ b/cmake/coremath_roundeven.c
@@ -0,0 +1,15 @@
+/* roundeven/roundevenf for C libraries without them (MinGW-w64 UCRT):
+   round half to even, independent of the current rounding mode. */
+#include <math.h>
+
+double roundeven(double x) {
+  double r = round(x);
+  if (fabs(r - x) == 0.5) r = 2.0 * round(x * 0.5);
+  return r;
+}
+
+float roundevenf(float x) {
+  float r = roundf(x);
+  if (fabsf(r - x) == 0.5f) r = 2.0f * roundf(x * 0.5f);
+  return r;
+}
