+#pragma once
+// The few POSIX pieces the runtime's diagnostics use, for Windows hosts
+// (MinGW-w64 UCRT). Included in place of <execinfo.h>; the fault handler
+// itself is Windows code (dispatch.cpp), not an emulation of signals.
+#if defined(_WIN32)
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <psapi.h>
+
+#include <fcntl.h>
+#include <io.h>
+#include <cstdio>
+
+#ifndef O_CLOEXEC
+#define O_CLOEXEC 0
+#endif
+
+// The watchdog's per-thread stack dumps need a signal Windows lacks;
+// pthread_kill with it fails, so those threads read "(thread gone)".
+#ifndef SIGUSR2
+#define SIGUSR2 31
+#endif
+
+inline int backtrace(void** frames, int max) {
+  return int(RtlCaptureStackBackTrace(1, DWORD(max), frames, nullptr));
+}
+
+// module+offset per frame (no symbol tables in release builds).
+inline void backtrace_symbols_fd(void* const* frames, int n, int fd) {
+  for (int i = 0; i < n; i++) {
+    HMODULE m = nullptr;
+    char name[MAX_PATH] = "?";
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                               GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           static_cast<const char*>(frames[i]), &m) &&
+        m)
+      GetModuleFileNameA(m, name, sizeof name);
+    const char* base = name;
+    for (const char* p = name; *p; p++)
+      if (*p == '\\' || *p == '/') base = p + 1;
+    char line[MAX_PATH + 64];
+    const int len = std::snprintf(line, sizeof line, "%s+0x%llx [%p]\n", base,
+                                  (unsigned long long)(static_cast<const char*>(frames[i]) -
+                                                       reinterpret_cast<const char*>(m)),
+                                  frames[i]);
+    if (len > 0) (void)!_write(fd, line, unsigned(len));
+  }
+}
+
+#endif
