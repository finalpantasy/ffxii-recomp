diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7e237d1..731f708 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,6 +10,41 @@ project(SwARc LANGUAGES C CXX)
 # the parts its program imports; see README.md.
 
 set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
+# MSYS2 shells drop PROCESSOR_ARCHITECTURE, which CMake reads on Windows.
+if(WIN32 AND NOT CMAKE_SYSTEM_PROCESSOR AND CMAKE_SIZEOF_VOID_P EQUAL 8)
+  set(CMAKE_SYSTEM_PROCESSOR AMD64)
+endif()
+# MinGW-w64's off_t, lseek and struct stat are 32-bit unless asked; game
+# archives pass 4 GB.
+if(MINGW)
+  add_compile_definitions(_FILE_OFFSET_BITS=64)
+endif()
+
+# Windows hosts (MinGW-w64 UCRT, clang): the runtime libraries are static.
+# A DLL cannot export its thread-locals, and the fault handler and HLE
+# share many. HLE handlers register themselves from static initialisers,
+# so programs take every runtime library whole (recomp_whole_archive).
+if(WIN32)
+  function(add_library name)
+    set(_args ${ARGN})
+    list(FIND _args SHARED _i)
+    if(NOT _i EQUAL -1)
+      list(REMOVE_AT _args ${_i})
+      list(INSERT _args ${_i} STATIC)
+      set_property(GLOBAL APPEND PROPERTY RECOMP_STATIC_LIBS ${name})
+    endif()
+    _add_library(${name} ${_args})
+  endfunction()
+endif()
+# recomp_whole_archive(<target>): on Windows, links every runtime library
+# into <target> whole, so no self-registering object is dropped.
+function(recomp_whole_archive target)
+  if(WIN32)
+    get_property(_libs GLOBAL PROPERTY RECOMP_STATIC_LIBS)
+    string(REPLACE ";" "," _list "${_libs}")
+    set_property(TARGET ${target} PROPERTY LINK_LIBRARY_OVERRIDE "WHOLE_ARCHIVE,${_list}")
+  endif()
+endfunction()
 
 # For the helper functions below, which run in the game project's scope.
 set(RECOMP_ROOT "${CMAKE_CURRENT_SOURCE_DIR}" CACHE INTERNAL "")
@@ -232,7 +267,7 @@ add_library(recomp_base SHARED
   src/runtime/guest_memory.cpp
   src/runtime/guest_alloc.cpp
   src/runtime/lazy_mem.cpp
-  src/runtime/platform.cpp
+  $<IF:$<BOOL:${WIN32}>,src/runtime/platform_win.cpp,src/runtime/platform.cpp>
   src/runtime/pacing.cpp
   src/runtime/write_watch.cpp)
 target_include_directories(recomp_base PUBLIC src)
