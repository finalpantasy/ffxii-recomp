diff --git a/platforms/win32/src/win32/kernel32_sync.cpp b/platforms/win32/src/win32/kernel32_sync.cpp
index 752201c..ce58be9 100644
--- a/platforms/win32/src/win32/kernel32_sync.cpp
+++ b/platforms/win32/src/win32/kernel32_sync.cpp
@@ -12,7 +12,9 @@
 // synchronises opens a GuestSyncPoint, which makes the call a full
 // barrier as on Windows (see kernel32_state.h).
 
+#if !defined(_WIN32)
 #include <sys/mman.h>
+#endif
 #include <sys/stat.h>
 #include <unistd.h>
 
@@ -794,6 +796,27 @@ uint32_t MapView(uint32_t h, uint32_t access, uint32_t off_hi, uint32_t off_lo,
   bool write = (access & 0x2) && m->writable;  // FILE_MAP_WRITE
   // Copy-on-write (FILE_MAP_COPY) and read views are private; write views
   // are shared with the file.
+#if defined(_WIN32)
+  // Windows hosts: the arena is one reservation, which a file view cannot
+  // be placed into, so views are copies. Shared write views (writes that
+  // reach the file) are not supported there yet.
+  if (write) {
+    g_proc->vm.Release(base);
+    SetLastError(kErrorAccessDenied);
+    return 0;
+  }
+  g_proc->mem.Commit(base, size, Prot::R);
+  if (_lseeki64(m->fd, int64_t(off), SEEK_SET) < 0) {
+    g_proc->vm.Release(base);
+    SetLastError(kErrorAccessDenied);
+    return 0;
+  }
+  for (uint32_t done = 0; done < size;) {
+    const int n = _read(m->fd, static_cast<uint8_t*>(GPtr(base)) + done, size - done);
+    if (n <= 0) break;  // past the end of the file: the rest reads zero
+    done += uint32_t(n);
+  }
+#else
   int flags = MAP_FIXED | (write ? MAP_SHARED : MAP_PRIVATE);
   void* p = mmap(GPtr(base), size, PROT_READ | PROT_WRITE, flags, m->fd, off_t(off));
   if (p == MAP_FAILED) {
@@ -804,6 +827,7 @@ uint32_t MapView(uint32_t h, uint32_t access, uint32_t off_hi, uint32_t off_lo,
   // Tell the page table these guest pages are committed (the host pages
   // are already accessible through the file mapping).
   g_proc->mem.Commit(base, size, write ? Prot::RW : Prot::R);
+#endif
   std::lock_guard<std::mutex> l(g_views_mu);
   g_views.insert(base);
   return base;
