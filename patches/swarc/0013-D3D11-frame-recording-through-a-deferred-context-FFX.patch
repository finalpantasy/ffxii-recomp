+// Frame recording (FFXII_D3D_RECORD=1): the game's immediate-context calls go
+// to a host deferred context, and the recorded list runs on the immediate
+// context at every sync point (Present, GetData, Flush, reading maps).
+// Executes what is recorded so far; a no-op when recording is off.
+void D3d11FlushRecorded();
+
 }  // namespace recomp::hle
