+        const uint8_t* g = GPtr(mapping.guest_data);
+        object->mirror.assign(g, g + mapping.size);
+      }
       D3D11_BUFFER_DESC desc{};
       if (g_buffer_upload_hook && BufferDesc(resource, &desc))
         g_buffer_upload_hook(GPtr(mapping.guest_data), mapping.size, desc.BindFlags,
@@ -487,6 +559,19 @@ uint32_t Unmap(Ctx& c) {
 
 }  // namespace
 
+void D3d11FlushRecorded() {
+  if (!g_rec.deferred) return;
+  ID3D11CommandList* list = nullptr;
+  HRESULT hr = g_rec.deferred->FinishCommandList(TRUE, &list);
+  ++g_rec.list;
+  if (FAILED(hr) || !list) {
+    WarnF("d3d11: FinishCommandList failed: 0x%08X\n", uint32_t(hr));
+    return;
+  }
+  g_rec.immediate->ExecuteCommandList(list, FALSE);
+  list->Release();
+}
