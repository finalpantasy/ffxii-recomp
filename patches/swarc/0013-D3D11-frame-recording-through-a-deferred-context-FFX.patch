 platforms/win32/src/win32/d3d11.h   |   6 +
 platforms/win32/src/win32/dxgi.cpp  |   2 +
 platforms/win32/src/win32/dxvk.h    |   4 +
 4 files changed, 151 insertions(+), 49 deletions(-)

diff --git a/platforms/win32/src/win32/d3d11.cpp b/platforms/win32/src/win32/d3d11.cpp
index ecaa9e6..a99ede2 100644
--- a/platforms/win32/src/win32/d3d11.cpp
+++ b/platforms/win32/src/win32/d3d11.cpp
@@ -26,6 +26,42 @@ BufferUploadHook g_buffer_upload_hook = nullptr;
 namespace {
 
 constexpr const char* kDll = "d3d11.dll";
+
+// ---- frame recording (see d3d11.h) ----------------------------------------
+struct Recorder {
+  ID3D11DeviceContext* immediate = nullptr;
+  ID3D11DeviceContext* deferred = nullptr;
+  uint64_t list = 1;  // serial of the command list being recorded
+  uint64_t calls = 0;
+};
+Recorder g_rec;
+
+// The host context for a guest context: the deferred one in place of the
+// immediate context while recording.
+ID3D11DeviceContext* HostContext(gaddr guest) {
+  ID3D11DeviceContext* host = DxvkHost<ID3D11DeviceContext>(guest);
+  if (g_rec.deferred && host == g_rec.immediate) return g_rec.deferred;
+  return host;
+}
+// The host context itself, after running what was recorded: for calls a
+// deferred context cannot make (GetData, reading maps, Flush).
+ID3D11DeviceContext* SyncContext(gaddr guest) {
+  ID3D11DeviceContext* host = DxvkHost<ID3D11DeviceContext>(guest);
+  if (g_rec.deferred && host == g_rec.immediate) D3d11FlushRecorded();
+  return host;
+}
+
+void StartRecording(ID3D11Device* device, ID3D11DeviceContext* immediate) {
+  if (!device || !immediate || g_rec.deferred || !Env("D3D_RECORD")) return;
+  ID3D11DeviceContext* deferred = nullptr;
+  if (FAILED(device->CreateDeferredContext(0, &deferred)) || !deferred) {
+    WarnF("d3d11: CreateDeferredContext failed; frame recording off\n");
+    return;
+  }
+  g_rec.immediate = immediate;
+  g_rec.deferred = deferred;
+  std::fprintf(stderr, "[d3d11] frame recording on (deferred context)\n");
+}
 constexpr uint32_t kEInvalidArg = 0x80070057;
 constexpr uint32_t kEOutOfMemory = 0x8007000E;
 
