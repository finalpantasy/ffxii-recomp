+  HRESULT hr = context->Map(resource, uint32_t(Arg(c, 2)), host_type, uint32_t(Arg(c, 4)), &mapped);
+  if (SUCCEEDED(hr) && deferred && object && host_type == D3D11_MAP_WRITE_DISCARD)
+    object->discard_list = g_rec.list;
   if (FAILED(hr)) return uint32_t(hr);
   size_t size = MappedSize(resource, uint32_t(Arg(c, 2)), mapped);
   if (!size) {
@@ -441,9 +494,16 @@ uint32_t Map(Ctx& c) {
   // Unmap copies the whole shadow back, so every map but WRITE_DISCARD must
   // start from the buffer's contents: a NO_OVERWRITE map of a ring buffer
   // writes one slice and the rest is still queued for earlier draws.
-  if (type != D3D11_MAP_WRITE_DISCARD)
