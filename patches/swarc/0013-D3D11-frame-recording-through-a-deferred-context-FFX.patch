+      const size_t n = std::min(size, object->mirror.size());
+      if (n) std::memcpy(GPtr(shadow), object->mirror.data(), n);
+    } else {
+      std::memcpy(GPtr(shadow), mapped.pData, size);
+    }
+  }
+  (void)refill;
   object->mappings[uint32_t(Arg(c, 2))] =
       DxvkMapping{mapped.pData, shadow, size, uint32_t(type)};
   Wr64(out, shadow);
@@ -461,16 +521,28 @@ bool BufferDesc(ID3D11Resource* resource, D3D11_BUFFER_DESC* desc) {
 }
 
 uint32_t Unmap(Ctx& c) {
-  ID3D11DeviceContext* context = DxvkHost<ID3D11DeviceContext>(Arg(c, 0));
   ID3D11Resource* resource = DxvkHost<ID3D11Resource>(Arg(c, 1));
   DxvkObject* object = com::As<DxvkObject>(Arg(c, 1));
   uint32_t subresource = uint32_t(Arg(c, 2));
