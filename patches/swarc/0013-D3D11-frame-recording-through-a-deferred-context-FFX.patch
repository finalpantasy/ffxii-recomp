+  const bool writes_only = it == object->mappings.end() ||
+                           it->second.type == D3D11_MAP_WRITE_DISCARD ||
+                           it->second.type == D3D11_MAP_WRITE_NO_OVERWRITE;
+  ID3D11DeviceContext* context =
+      writes_only ? HostContext(Arg(c, 0)) : DxvkHost<ID3D11DeviceContext>(Arg(c, 0));
+  if (!context) return 0;
   if (it != object->mappings.end()) {
     const DxvkMapping mapping = it->second;
     if (mapping.type != D3D11_MAP_READ) {
       std::memcpy(mapping.host_data, GPtr(mapping.guest_data), mapping.size);
+      D3D11_RESOURCE_DIMENSION dim = D3D11_RESOURCE_DIMENSION_UNKNOWN;
+      if (g_rec.deferred) resource->GetType(&dim);
+      if (dim == D3D11_RESOURCE_DIMENSION_BUFFER && (mapping.type == D3D11_MAP_WRITE_DISCARD ||
