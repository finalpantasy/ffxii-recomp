+// ---- inline entry points ----------------------------------------------
+// Lifted code keeps XMM registers in locals (lifter CacheXmm). A local
+// whose address reaches an out-of-line function counts as escaped, and
+// the compiler then reloads it after every guest memory store. These
+// wrappers hand the out-of-line versions copies instead.
+#define RECOMP_SSE_DS(call)  \
+  Xmm td = d;                \
+  const Xmm ts = s;          \
+  call;                      \
+  d = td
+[[gnu::always_inline]] inline void Cmp(Ctx& c, bool dbl, int lanes, Xmm& d, const Xmm& s,
+                                       uint8_t pred, uint64_t va) {
+  RECOMP_SSE_DS(CmpOol(c, dbl, lanes, td, ts, pred, va));
+}
+// Under lazy flags (all exceptions masked, nearest, no DAZ/FTZ) the result
+// needs no MXCSR work: the low lanes compared as the host compares them.
+[[gnu::always_inline]] inline int Comi(Ctx& c, bool dbl, bool ordered, const Xmm& a,
+                                       const Xmm& b, uint64_t va) {
+#if defined(__x86_64__)
+  if (quiet::Lazy(c)) {
+    if (dbl) {
+      double x, y;
+      std::memcpy(&x, a.b, 8);
+      std::memcpy(&y, b.b, 8);
+      return (x != x || y != y) ? 3 : x == y ? 2 : x < y ? 1 : 0;
+    }
+    float x, y;
+    std::memcpy(&x, a.b, 4);
+    std::memcpy(&y, b.b, 4);
+    return (x != x || y != y) ? 3 : x == y ? 2 : x < y ? 1 : 0;
+  }
+#endif
+  const Xmm ta = a, tb = b;
+  return ComiOol(c, dbl, ordered, ta, tb, va);
+}
+[[gnu::always_inline]] inline void Rsqrt(Xmm& d, const Xmm& s) { RECOMP_SSE_DS(RsqrtOol(td, ts)); }
+[[gnu::always_inline]] inline void Cvtsi2sd(Xmm& d, int32_t v) {
+  Xmm td = d;
+  Cvtsi2sdOol(td, v);
+  d = td;
+}
+[[gnu::always_inline]] inline uint32_t CvtToI32(Ctx& c, bool dbl, const Xmm& s, bool truncate,
+                                                uint64_t va) {
+  const Xmm ts = s;
+  return CvtToI32Ool(c, dbl, ts, truncate, va);
+}
+[[gnu::always_inline]] inline uint64_t CvtToI64(Ctx& c, bool dbl, const Xmm& s, bool truncate,
+                                                uint64_t va) {
+  const Xmm ts = s;
+  return CvtToI64Ool(c, dbl, ts, truncate, va);
+}
+[[gnu::always_inline]] inline void CvtFloat(Ctx& c, bool to_dbl, int lanes, Xmm& d, const Xmm& s,
+                                            uint64_t va) {
+  RECOMP_SSE_DS(CvtFloatOol(c, to_dbl, lanes, td, ts, va));
+}
+[[gnu::always_inline]] inline void CvtIntToF(Ctx& c, bool dbl, bool src64, uint64_t v, Xmm& d,
+                                             uint64_t va) {
+  Xmm td = d;
+  CvtIntToFOol(c, dbl, src64, v, td, va);
+  d = td;
+}
+[[gnu::always_inline]] inline void CvtToDq(Ctx& c, bool dbl, bool truncate, Xmm& d, const Xmm& s,
+                                           uint64_t va) {
+  RECOMP_SSE_DS(CvtToDqOol(c, dbl, truncate, td, ts, va));
+}
+[[gnu::always_inline]] inline void Cvtph2ps(Ctx& c, Xmm& d, const Xmm& s, int from, uint64_t va) {
+  RECOMP_SSE_DS(Cvtph2psOol(c, td, ts, from, va));
+}
+[[gnu::always_inline]] inline void Cvtps2ph(Ctx& c, Xmm& d, int to, const Xmm& s, uint8_t imm,
+                                            uint64_t va) {
+  RECOMP_SSE_DS(Cvtps2phOol(c, td, to, ts, imm, va));
+}
+[[gnu::always_inline]] inline void HorizOp(Ctx& c, bool dbl, bool sub, Xmm& d, const Xmm& s,
+                                           uint64_t va) {
+  RECOMP_SSE_DS(HorizOpOol(c, dbl, sub, td, ts, va));
+}
+[[gnu::always_inline]] inline void AddSub(Ctx& c, bool dbl, Xmm& d, const Xmm& s, uint64_t va) {
+  RECOMP_SSE_DS(AddSubOol(c, dbl, td, ts, va));
+}
+[[gnu::always_inline]] inline void Round(Ctx& c, bool dbl, int lanes, Xmm& d, const Xmm& s,
+                                         uint8_t imm, uint64_t va) {
+  RECOMP_SSE_DS(RoundOol(c, dbl, lanes, td, ts, imm, va));
+}
+[[gnu::always_inline]] inline void Dp(Ctx& c, bool dbl, Xmm& d, const Xmm& s, uint8_t imm,
+                                      uint64_t va) {
+  RECOMP_SSE_DS(DpOol(c, dbl, td, ts, imm, va));
+}
+[[gnu::always_inline]] inline void Rcp(Xmm& d, const Xmm& s) { RECOMP_SSE_DS(RcpOol(td, ts)); }
+[[gnu::always_inline]] inline void Cvtdq2ps(Ctx& c, Xmm& d, const Xmm& s, uint64_t va) {
+  RECOMP_SSE_DS(Cvtdq2psOol(c, td, ts, va));
+}
+#undef RECOMP_SSE_DS
+
 }  // namespace recomp::sse
