+// ---- blend recording worker -----------------------------------------------
+// The blend context records on its own thread. The render thread makes each
+// call on the main recording context and queues a copy for the blend context:
+// arrays and upload data are copied, interfaces held with a reference until
+// the worker has made the call. Constant-buffer blending runs on the worker.
+template <class T>
+constexpr bool kIsCom = std::is_pointer_v<T> &&
+                        std::is_base_of_v<IUnknown, std::remove_cv_t<std::remove_pointer_t<T>>>;
+
+template <class E>
+struct Span {
+  const E* p;
+  size_t n;
+};
+template <class E>
+Span<E> Arr(const E* p, size_t n) {
+  return {p, p ? n : 0};
+}
+
+template <class E>
+struct OwnedArr {
+  E inl[16];
+  std::vector<E> big;
+  const E* p = nullptr;
+  size_t n = 0;
+  explicit OwnedArr(Span<E> s) : n(s.n) {
+    if (!s.p) return;
+    E* d = inl;
+    if (n > 16) {
+      big.resize(n);
+      d = big.data();
+    }
+    std::memcpy(static_cast<void*>(d), s.p, n * sizeof(E));
+    if constexpr (kIsCom<E>)
+      for (size_t i = 0; i < n; ++i)
+        if (d[i]) d[i]->AddRef();
+    p = d;
+  }
+  OwnedArr(const OwnedArr&) = delete;
+  OwnedArr& operator=(const OwnedArr&) = delete;
+  ~OwnedArr() {
+    if constexpr (kIsCom<E>)
+      if (p)
+        for (size_t i = 0; i < n; ++i)
+          if (p[i]) p[i]->Release();
+  }
+  operator const E*() const { return p; }
+};
+
+template <class T>
+struct OwnedCom {
+  T* p;
+  explicit OwnedCom(T* v) : p(v) {
+    if (p) p->AddRef();
+  }
+  OwnedCom(const OwnedCom&) = delete;
+  OwnedCom& operator=(const OwnedCom&) = delete;
+  ~OwnedCom() {
+    if (p) p->Release();
+  }
+  operator T*() const { return p; }
+};
+
+template <class A>
+struct OwnOf {
+  static_assert(!std::is_pointer_v<A> || kIsCom<A>,
+                "a guest pointer queued for the blend context must be copied: wrap it in Arr()");
+  using type = std::conditional_t<kIsCom<A>, OwnedCom<std::remove_pointer_t<A>>, A>;
+};
+template <class E>
+struct OwnOf<Span<E>> {
+  using type = OwnedArr<E>;
+};
+
+template <class A>
+A Raw(A a) {
+  return a;
+}
+template <class E>
+const E* Raw(Span<E> s) {
+  return s.p;
+}
+
+template <class M, class... A>
+struct QueuedCall {
+  M m;
+  std::tuple<typename OwnOf<A>::type...> args;
+  explicit QueuedCall(M method, A... a) : m(method), args(a...) {}
+  void operator()(ID3D11DeviceContext* ctx, uint8_t*) {
+    std::apply([&](auto&... x) { (ctx->*m)(x...); }, args);
+  }
+};
+
+constexpr size_t R16(size_t n) { return (n + 15) & ~size_t(15); }
+
+class BlendWorker {
+ public:
+  // Space for one command of type F plus `extra` payload bytes; construct
+  // with Emplace, fill the payload, then Commit.
+  template <class F, class... CA>
+  uint8_t* Emplace(size_t extra, CA&&... ca) {
+    static constexpr size_t off = R16(sizeof(Hdr));
+    static constexpr size_t foff = off + R16(sizeof(F));
+    const size_t total = foff + R16(extra);
+    uint8_t* e = Alloc(total);
+    auto* h = reinterpret_cast<Hdr*>(e);
+    h->size = total;
+    h->run = [](uint8_t* entry, ID3D11DeviceContext* ctx) {
+      F* f = reinterpret_cast<F*>(entry + off);
+      (*f)(ctx, entry + foff);
+      f->~F();
+    };
+    new (e + off) F(std::forward<CA>(ca)...);
+    return e + foff;
+  }
+  void Commit() {
+    // FFXII_D3D_INTERP_KICK_KB: how much is queued before the worker gets it.
+    static const size_t kick = [] {
+      const char* v = Env("D3D_INTERP_KICK_KB");
+      return v ? size_t(std::atoi(v)) << 10 : kKick;
+    }();
+    if (cur_ && cur_->used >= kick) Kick();
+  }
+  // Hands what is queued to the worker.
+  void Kick() {
+    if (!cur_ || !cur_->used) return;
+    {
+      std::lock_guard<std::mutex> lock(mu_);
+      if (!started_) {
+        started_ = true;
+#ifdef _WIN32
+        // The worker runs at the priority of the thread that feeds it (the
+        // game's render thread), or it falls behind whenever the PC is busy.
+        const int prio = GetThreadPriority(GetCurrentThread());
+        std::thread([this, prio] {
+          SetThreadPriority(GetCurrentThread(), prio);
+          Loop();
+        }).detach();
+        std::fprintf(stderr, "[d3d11] blend worker started at thread priority %d\n", prio);
+#else
+        std::thread(&BlendWorker::Loop, this).detach();
+#endif
+      }
+      ready_.push_back(cur_);
+    }
+    cur_ = nullptr;
+    pending_.fetch_add(1, std::memory_order_release);
+    wake_.notify_one();
+  }
+  // Waits until every queued command has run.
+  void Drain() {
+    Kick();
+    std::unique_lock<std::mutex> lock(mu_);
+    idle_.wait(lock, [this] { return ready_.empty() && !busy_; });
+  }
+  uint64_t drains = 0;
+  std::atomic<uint64_t> busy_ns{0};
+
+ private:
+  struct Hdr {
+    void (*run)(uint8_t*, ID3D11DeviceContext*);
+    size_t size;
+  };
+  struct Chunk {
+    uint8_t* buf;
+    size_t cap, used;
+  };
+  static constexpr size_t kChunk = 256 << 10, kKick = 64 << 10;
+
+  uint8_t* Alloc(size_t n) {
+    if (!cur_ || cur_->used + n > cur_->cap) {
+      Kick();
+      cur_ = Take(n);
+    }
+    uint8_t* p = cur_->buf + cur_->used;
+    cur_->used += n;
+    return p;
+  }
+  Chunk* Take(size_t n) {
+    {
+      std::lock_guard<std::mutex> lock(mu_);
+      for (size_t i = 0; i < free_.size(); ++i)
+        if (free_[i]->cap >= n) {
+          Chunk* c = free_[i];
+          free_.erase(free_.begin() + ptrdiff_t(i));
+          return c;
+        }
+    }
+    const size_t cap = std::max(kChunk, n);
+    return new Chunk{static_cast<uint8_t*>(std::malloc(cap)), cap, 0};
+  }
+  void Loop() {
+    for (;;) {
+      Chunk* c;
+      // A short spin first: under load, every sleep and wake costs scheduler time.
+      static const int spin_us = [] {
+        const char* v = Env("D3D_INTERP_SPIN_US");
+        return v ? std::atoi(v) : 300;
+      }();
+      const auto spin_end = std::chrono::steady_clock::now() + std::chrono::microseconds(spin_us);
+      while (pending_.load(std::memory_order_acquire) == 0 &&
+             std::chrono::steady_clock::now() < spin_end)
+        std::this_thread::yield();
+      {
+        std::unique_lock<std::mutex> lock(mu_);
+        wake_.wait(lock, [this] { return !ready_.empty(); });
+        pending_.fetch_sub(1, std::memory_order_relaxed);
+        c = ready_.front();
+        ready_.pop_front();
+        busy_ = true;
+      }
+      const auto t0 = std::chrono::steady_clock::now();
+      for (size_t at = 0; at < c->used;) {
+        auto* h = reinterpret_cast<Hdr*>(c->buf + at);
+        const size_t size = h->size;
+        h->run(c->buf + at, g_rec.blend);
+        at += size;
+      }
+      c->used = 0;
+      busy_ns.fetch_add(uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                     std::chrono::steady_clock::now() - t0).count()),
+                        std::memory_order_relaxed);
+      {
+        std::lock_guard<std::mutex> lock(mu_);
+        free_.push_back(c);
+        busy_ = false;
+      }
+      idle_.notify_all();
+    }
+  }
+
+  std::mutex mu_;
+  std::condition_variable wake_, idle_;
+  std::deque<Chunk*> ready_;
+  std::vector<Chunk*> free_;
+  Chunk* cur_ = nullptr;  // render thread only
+  bool busy_ = false, started_ = false;
+  std::atomic<int> pending_{0};
+};
+BlendWorker g_worker;
+
+// Worker-side state: what the blend context's list has mapped, and each
+// dynamic buffer's last contents for the prefill.
+struct WorkerDyn {
+  std::vector<uint8_t> bytes;
+  uint64_t list = 0;
+};
+struct WorkerState {
+  uint64_t list = 1;
+  std::unordered_set<ID3D11Resource*> discarded;  // DISCARD-mapped in this list
+  std::unordered_map<ID3D11Resource*, WorkerDyn> dyn;
+};
+WorkerState g_ws;
+
+// Makes a context call: on the guest's context, or while recording on the
+// main recording context with a copy queued for the blend context.
+template <class M, class... A>
+void Rec(gaddr guest, M m, A... a) {
+  ID3D11DeviceContext* host = DxvkHost<ID3D11DeviceContext>(guest);
+  if (g_rec.deferred && host == g_rec.immediate) {
+    (g_rec.deferred->*m)(Raw(a)...);
+    if (g_rec.blend) {
+      g_worker.Emplace<QueuedCall<M, A...>>(0, m, a...);
+      g_worker.Commit();
+    }
+    return;
+  }
+  (host->*m)(Raw(a)...);
+}
+template <class M>
+struct RecOn {
+  gaddr guest;
+  M m;
+  template <class... A>
+  void operator()(A... a) const {
+    Rec(guest, m, a...);
+  }
+};
+template <class M>
+RecOn<M> RecCall(gaddr guest, M m) {
+  return {guest, m};
+}
+
+// A buffer or texture write made on the main recording context, replayed on
+// the blend context: constant buffers blended, dynamic buffers remembered for
+// the prefill.
+struct QueuedWrite {
+  OwnedCom<ID3D11Resource> res;
+  uint32_t sub, size;
+  bool map, no_overwrite, constant, dynamic_buffer, has_box;
+  D3D11_BOX box;
+  QueuedWrite(ID3D11Resource* r, uint32_t s, uint32_t n, bool m, bool nov, bool cb, bool dyn,
+              const D3D11_BOX* b)
+      : res(r), sub(s), size(n), map(m), no_overwrite(nov), constant(cb), dynamic_buffer(dyn),
+        has_box(b != nullptr), box(b ? *b : D3D11_BOX{}) {}
+  void operator()(ID3D11DeviceContext* ctx, uint8_t* data) {
+    if (constant) BlendUploadInto(data, data, size);
+    if (!map) {
+      ctx->UpdateSubresource(res, sub, has_box ? &box : nullptr, data, 0, 0);
+      return;
+    }
+    D3D11_MAP t = D3D11_MAP_WRITE_DISCARD;
+    if (no_overwrite && g_ws.discarded.count(res)) t = D3D11_MAP_WRITE_NO_OVERWRITE;
+    D3D11_MAPPED_SUBRESOURCE bm{};
+    if (FAILED(ctx->Map(res, sub, t, 0, &bm))) {
+      if (++g_rec.map_fails < 4) WarnF("d3d11: blend Map failed (type %d)" "\n", int(t));
+      return;
+    }
+    std::memcpy(bm.pData, data, size);
+    ctx->Unmap(res, sub);
+    if (t == D3D11_MAP_WRITE_DISCARD) g_ws.discarded.insert(res);
+    if (dynamic_buffer) {
+      auto [it, fresh] = g_ws.dyn.try_emplace(res);
+      if (fresh) res.p->AddRef();
+      it->second.bytes.assign(data, data + size);
+      it->second.list = g_ws.list;
+    }
+  }
+};
