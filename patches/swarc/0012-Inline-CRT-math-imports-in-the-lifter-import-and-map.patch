+#pragma once
+// CRT math that the lifter emits inline at calls to an import (manifest
+// `crt`), with the same results and errno as the HLE handlers: correctly
+// rounded (CORE-MATH) where the result is not exact. Defined by the
+// platform's CRT layer (platforms/win32/src/win32/ucrt.cpp).
+
+namespace recomp::crt {
+float Sinf(float);
+float Cosf(float);
+float Tanf(float);
+float Asinf(float);
+float Acosf(float);
+float Expf(float);
+float Logf(float);
+float Atan2f(float, float);
+float Powf(float, float);
+}  // namespace recomp::crt
