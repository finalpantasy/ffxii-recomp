+namespace {
+// <ID>_IMPORT_STATS=1: count calls per import slot and, every 30 s, log the
+// 40 most called imports with their calls per second since the last report.
+std::atomic<uint64_t> g_import_calls[kMaxSlots];
+void ImportStats(size_t idx) {
+  static const bool on = Env("IMPORT_STATS") != nullptr;
+  if (!on) return;
+  g_import_calls[idx].fetch_add(1, std::memory_order_relaxed);
+  using clock = std::chrono::steady_clock;
+  static std::atomic<int64_t> next{0};
+  const int64_t now = clock::now().time_since_epoch().count();
+  int64_t due = next.load(std::memory_order_relaxed);
+  if (due == 0) {
+    next.compare_exchange_strong(due, now + std::chrono::duration_cast<clock::duration>(
+                                                 std::chrono::seconds(30)).count());
+    return;
+  }
+  if (now < due || !next.compare_exchange_strong(
+                       due, now + std::chrono::duration_cast<clock::duration>(
+                                      std::chrono::seconds(30)).count()))
+    return;
+  static std::vector<uint64_t> last(kMaxSlots);
+  std::vector<std::pair<uint64_t, size_t>> rows;
+  for (size_t i = 0; i < kMaxSlots; i++) {
+    const uint64_t v = g_import_calls[i].load(std::memory_order_relaxed);
+    if (v != last[i]) rows.push_back({v - last[i], i});
+    last[i] = v;
+  }
+  std::sort(rows.rbegin(), rows.rend());
+  std::fprintf(stderr, "[imports] calls per second over the last 30 s:\n");
+  for (size_t k = 0; k < rows.size() && k < 40; k++) {
+    const Slot* s = g_slot_table[rows[k].second].load(std::memory_order_acquire);
+    std::fprintf(stderr, "[imports]   %10.1f %s!%s\n", rows[k].first / 30.0,
+                 s ? s->dll.c_str() : "?", s ? s->name.c_str() : "?");
+  }
+}
+}  // namespace
+
