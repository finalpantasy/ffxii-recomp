@@ -609,6 +609,41 @@ class InsnEmitter {
   bool IsXmm(int i) const {
     return xsub_.count(i) || (IsReg(i) && XmmIndex(Op(i).reg.value) >= 0);
   }
+  // A call to a CRT import (manifest `crt`): the HLE handler's host work,
+  // inline, with no spill, push or dispatch. The volatile registers the
+  // real function may clobber keep their values. Float arguments and
+  // results are in the low lanes of xmm0 and xmm1 (Win64).
+  void EmitCrt(const std::string& n) {
+    if (n == "memset") {
+      L("std::memset(B + rcx, int(uint8_t(rdx)), size_t(r8));");
+      L("rax = rcx;");
+    } else if (n == "memcpy" || n == "memmove") {
+      L("std::memmove(B + rcx, B + rdx, size_t(r8));");
+      L("rax = rcx;");
+    } else if (n == "memcmp") {
+      L("{ const int r = std::memcmp(B + rcx, B + rdx, size_t(r8)); "
+        "rax = uint32_t(r < 0 ? -1 : r > 0 ? 1 : 0); }");
+    } else if (n == "sqrt") {
+      L("{ double x; std::memcpy(&x, c.xmm[0].b, 8); x = std::sqrt(x); "
+        "std::memcpy(c.xmm[0].b, &x, 8); }");
+    } else if (n == "_isnan" || n == "_finite") {
+      L(Fmt("{ double x; std::memcpy(&x, c.xmm[0].b, 8); rax = std::%s(x) ? 1 : 0; }",
+            n == "_isnan" ? "isnan" : "isfinite"));
+    } else {
+      static const std::map<std::string, std::string> kF = {
+          {"sqrtf", "std::sqrt(x)"},          {"floorf", "std::floor(x)"},
+          {"ceilf", "std::ceil(x)"},          {"fmodf", "std::fmod(x, y)"},
+          {"sinf", "::recomp::crt::Sinf(x)"}, {"cosf", "::recomp::crt::Cosf(x)"},
+          {"tanf", "::recomp::crt::Tanf(x)"}, {"asinf", "::recomp::crt::Asinf(x)"},
+          {"acosf", "::recomp::crt::Acosf(x)"}, {"expf", "::recomp::crt::Expf(x)"},
+          {"logf", "::recomp::crt::Logf(x)"}, {"atan2f", "::recomp::crt::Atan2f(x, y)"},
+          {"powf", "::recomp::crt::Powf(x, y)"}};
+      const std::string& e = kF.at(n);
+      const bool two = e.find(", y") != std::string::npos;
+      L(Fmt("{ float x%s; std::memcpy(&x, c.xmm[0].b, 4);%s x = %s; std::memcpy(c.xmm[0].b, &x, 4); }",
+            two ? ", y" : "", two ? " std::memcpy(&y, c.xmm[1].b, 4);" : "", e.c_str()));
+    }
+  }
   std::string XmmRef(int i) const {
     auto it = xsub_.find(i);
     if (it != xsub_.end()) return it->second;
@@ -2965,14 +3000,7 @@ void InsnEmitter::Emit64() {
       if (IsImm(0)) {
