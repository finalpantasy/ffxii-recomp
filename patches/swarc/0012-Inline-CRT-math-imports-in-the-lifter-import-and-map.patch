+// RECOMP_D3D_MAP_STATS=1: every 20,000 maps, log the count per (resource
+// dimension, bind flags, map type).
+void CountMap(ID3D11Resource* resource, D3D11_MAP type) {
+  static const bool on = std::getenv("RECOMP_D3D_MAP_STATS") != nullptr;
+  if (!on) return;
+  static std::mutex mu;
+  static std::map<std::tuple<int, uint32_t, int>, uint64_t> counts;
+  static uint64_t total = 0;
+  D3D11_RESOURCE_DIMENSION dim = D3D11_RESOURCE_DIMENSION_UNKNOWN;
+  resource->GetType(&dim);
+  uint32_t bind = 0;
+  if (dim == D3D11_RESOURCE_DIMENSION_BUFFER) {
+    D3D11_BUFFER_DESC desc{};
+    static_cast<ID3D11Buffer*>(resource)->GetDesc(&desc);
+    bind = desc.BindFlags;
+  } else if (dim == D3D11_RESOURCE_DIMENSION_TEXTURE2D) {
+    D3D11_TEXTURE2D_DESC desc{};
+    static_cast<ID3D11Texture2D*>(resource)->GetDesc(&desc);
+    bind = desc.BindFlags;
+  }
+  std::lock_guard<std::mutex> lock(mu);
+  ++counts[{int(dim), bind, int(type)}];
+  if (++total % 20000) return;
+  std::fprintf(stderr, "[d3d11] maps so far %llu:", (unsigned long long)total);
+  for (auto& [k, n] : counts)
+    std::fprintf(stderr, " dim%d/bind0x%x/type%d=%llu", std::get<0>(k), std::get<1>(k),
+                 std::get<2>(k), (unsigned long long)n);
+  std::fprintf(stderr, "\n");
+}
+
 uint32_t Map(Ctx& c) {
   ID3D11DeviceContext* context = DxvkHost<ID3D11DeviceContext>(Arg(c, 0));
   ID3D11Resource* resource = DxvkHost<ID3D11Resource>(Arg(c, 1));
@@ -393,6 +425,7 @@ uint32_t Map(Ctx& c) {
   if (!context || !resource || !out) return kEInvalidArg;
   D3D11_MAPPED_SUBRESOURCE mapped{};
   D3D11_MAP type = D3D11_MAP(uint32_t(Arg(c, 3)));
+  CountMap(resource, type);
   HRESULT hr = context->Map(resource, uint32_t(Arg(c, 2)), type, uint32_t(Arg(c, 4)), &mapped);
   if (FAILED(hr)) return uint32_t(hr);
   size_t size = MappedSize(resource, uint32_t(Arg(c, 2)), mapped);
