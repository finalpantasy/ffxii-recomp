-          else
-            L("std::memmove(B + rcx, B + rdx, size_t(r8));");
-          L("rax = rcx;");
+          EmitCrt(crt->second);
           return;
         }
         Push64(Hex(next));
@@ -2987,6 +3015,16 @@ void InsnEmitter::Emit64() {
         // has once setjmp returns.
         if (p_.setjmps.count(t)) L("SJ = rsp;");
       } else {
+        // call [rip+slot] straight through an import slot (manifest `crt`
+        // with the slot's address).
+        if (Op(0).type == ZYDIS_OPERAND_TYPE_MEMORY && Op(0).mem.base == ZYDIS_REGISTER_RIP &&
+            Op(0).mem.index == ZYDIS_REGISTER_NONE) {
+          const uint64_t slot = in_.next() + uint64_t(Op(0).mem.disp.value);
+          if (auto crt = p_.crt_inline.find(slot); crt != p_.crt_inline.end()) {
+            EmitCrt(crt->second);
+            return;
+          }
+        }
         if (!PrepareMem()) return Unimpl();
         L("const uint64_t t = " + Read(0) + ";");
         Push64(Hex(next));
